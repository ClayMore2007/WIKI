      "y": -451,
      "width": 330,
      "height": 110,
      "color": "3",
      "styleAttributes": {
        "shape": "rounded-rectangle"
      }
    },
    {
      "id": "n7",
      "type": "text",
      "text": "互动：17赞 / 3评 / 1分享（低热度，新发布）",
      "x": 887,
      "y": -379,
      "width": 330,
      "height": 110,
      "color": "3",
      "styleAttributes": {
