{
  "language": "zh",
  "duration": 332.997375,
  "segments": [
    {
      "start": 0.0,
      "end": 1.6,
      "text": "咱们把设备聊完之后"
    },
    {
      "start": 1.6,
      "end": 2.52,
      "text": "这集视频"
    },
    {
      "start": 2.52,
      "end": 4.64,
      "text": "书里先进风装材料相关埋落"
    },
    {
      "start": 4.64,
      "end": 6.4,
      "text": "材料领域技术门砍更高"
    },
    {
      "start": 6.4,
      "end": 8.8,
      "text": "本土配套水平整体步级设备端"
    },
    {
      "start": 8.8,
      "end": 11.56,
      "text": "不少核心品类时常主要由海外企业占据"
    },
    {
      "start": 11.56,
      "end": 13.44,
      "text": "行业有着不小的成长空间"
    },
    {
      "start": 13.44,
      "end": 14.12,
      "text": "国内企业"
    },
    {
      "start": 14.12,
      "end": 16.36,
      "text": "躺着在西分塞道取得技术突破"
    },
    {
      "start": 16.36,
      "end": 18.28,
      "text": "后续发展前例值得关注"
    },
    {
      "start": 18.28,
      "end": 21.32,
      "text": "先来聊聊技术壁类较高的核心风装机彩"
    },
    {
      "start": 21.32,
      "end": 23.32,
      "text": "这类材料直接影响高贷款内存"
    },
    {
      "start": 23.32,
      "end": 26.4,
      "text": "等三维堆叠风装的使用性能与稳定程度"
    },
    {
      "start": 26.4,
      "end": 28.08,
      "text": "首先是还养素风料"
    },
    {
      "start": 28.08,
      "end": 30.52,
      "text": "涵盖颗粒与底部填充两类品类"
    },
    {
      "start": 30.52,
      "end": 32.96,
      "text": "现阶段高贷款内存配套彩料本土"
    },
    {
      "start": 32.96,
      "end": 34.08,
      "text": "攻击规模偏小"
    },
    {
      "start": 34.08,
      "end": 36.28,
      "text": "市场大多掌握在海外企业手中"
    },
    {
      "start": 36.28,
      "end": 40.0,
      "text": "华海城科具备高贷款内存专用颗粒素风料量产能力"
    },
    {
      "start": 40.0,
      "end": 41.68,
      "text": "产品各项指标达标"
    },
    {
      "start": 41.68,
      "end": 43.56,
      "text": "可适配十二层对跌工艺"
    },
    {
      "start": 43.56,
      "end": 45.68,
      "text": "也已经向相关场上稳定功货"
    },
    {
      "start": 45.68,
      "end": 47.28,
      "text": "企业完成并购整合后"
    },
    {
      "start": 47.28,
      "end": 48.76,
      "text": "行业地位稳部提升"
    },
    {
      "start": 48.76,
      "end": 50.4,
      "text": "相关产品引力表现可观"
    },
    {
      "start": 50.4,
      "end": 52.2,
      "text": "非凱彩料同样有所布局"
    },
    {
      "start": 52.2,
      "end": 54.56,
      "text": "现阶段产品多用于功率期间领域"
    },
    {
      "start": 54.56,
      "end": 57.08,
      "text": "也规划新增产现向高端品的延伸"
    },
    {
      "start": 57.08,
      "end": 59.36,
      "text": "后续产能释放要看客户验证进度"
    },
    {
      "start": 59.36,
      "end": 61.76,
      "text": "及次是高端芯片再版核心数值"
    },
    {
      "start": 61.76,
      "end": 64.04,
      "text": "该品类市场长期由海外品牌主导"
    },
    {
      "start": 64.04,
      "end": 66.44,
      "text": "华阵新财自研相关数值彩料"
    },
    {
      "start": 66.44,
      "end": 70.0,
      "text": "性能对标海外主流产品且具备成本优势"
    },
    {
      "start": 70.0,
      "end": 72.44,
      "text": "现役通过客户测试时限批量功货"
    },
    {
      "start": 72.44,
      "end": 74.92,
      "text": "预级2025年能够在头部场上中"
    },
    {
      "start": 74.92,
      "end": 76.28,
      "text": "收获相应市场份额"
    },
    {
      "start": 76.28,
      "end": 77.36,
      "text": "还有巨线压安"
    },
    {
      "start": 77.36,
      "end": 79.2,
      "text": "以及光明巨线压安彩料"
    },
    {
      "start": 82.2,
      "end": 84.56,
      "text": "相关产品正在客户出压证推进"
    },
    {
      "start": 84.56,
      "end": 87.56,
      "text": "首款光明巨线压安光可交也达成功货合作"
    },
    {
      "start": 87.56,
      "end": 88.8,
      "text": "取得阶段新进展"
    },
    {
      "start": 88.8,
      "end": 91.0,
      "text": "顶龙股份也在此领域布局研发"
    },
    {
      "start": 91.0,
      "end": 93.68,
      "text": "暂时还为大规模投入先进风装场景使用"
    },
    {
      "start": 93.68,
      "end": 95.44,
      "text": "顶龙股份再这块也有布局"
    },
    {
      "start": 95.44,
      "end": 96.92,
      "text": "不过在先进风装领域"
    },
    {
      "start": 96.92,
      "end": 98.56,
      "text": "还没到大规模应用的阶段"
    },
    {
      "start": 98.56,
      "end": 100.36,
      "text": "再来看黄光制成彩料"
    },
    {
      "start": 100.36,
      "end": 102.84,
      "text": "也就是光克和电度的配套号采"
    },
    {
      "start": 102.84,
      "end": 106.12,
      "text": "这块的国产化率在百分之零到百分之五十之间分化"
    },
    {
      "start": 106.12,
      "end": 107.48,
      "text": "光可交集配套世纪"
    },
    {
      "start": 107.48,
      "end": 109.52,
      "text": "整体国产化率不到百分之十"
    },
    {
      "start": 109.52,
      "end": 112.44,
      "text": "高端后焦基本依赖默克和日本的几家大厂"
    },
    {
      "start": 112.44,
      "end": 115.04,
      "text": "埃森股份在先进风装光克交这块"
    },
    {
      "start": 115.04,
      "end": 116.32,
      "text": "算是国内领先的"
    },
    {
      "start": 116.32,
      "end": 119.28,
      "text": "也是唯一打破日本巨头壟断的国内供应商"
    },
    {
      "start": 119.28,
      "end": 120.48,
      "text": "在盛合精微"
    },
    {
      "start": 120.48,
      "end": 123.28,
      "text": "长电还有华为区量电子都有放量"
    },
    {
      "start": 123.28,
      "end": 127.2,
      "text": "更是长新高带宽内存先进风装光克交的核心供应商"
    },
    {
      "start": 127.2,
      "end": 128.88,
      "text": "份额超过了百分之五十"
    },
    {
      "start": 128.88,
      "end": 132.2,
      "text": "另外同身新财的线和客户光克交也在加速放量"
    },
    {
      "start": 132.2,
      "end": 133.32,
      "text": "亚福也在突破"
    },
    {
      "start": 133.32,
      "end": 135.08,
      "text": "至于电度业和添加级"
    },
    {
      "start": 135.08,
      "end": 136.28,
      "text": "分化就挺明显的"
    },
    {
      "start": 136.32,
      "end": 138.48,
      "text": "黄金电度业国产化率是零"
    },
    {
      "start": 138.48,
      "end": 141.16,
      "text": "但吸引和涅电度业超过了百分之五十"
    },
    {
      "start": 141.16,
      "end": 142.72,
      "text": "埃森股份同样是主力"
    },
    {
      "start": 142.72,
      "end": 146.32,
      "text": "在大马市阁工艺和先进风装电度业上加速放量"
    },
    {
      "start": 146.32,
      "end": 150.32,
      "text": "在华红先进之城那边的电度业份额到了百分之五十"
    },
    {
      "start": 150.32,
      "end": 151.6,
      "text": "算第一供应商"
    },
    {
      "start": 151.6,
      "end": 153.44,
      "text": "而且他们的玻璃通宫要水"
    },
    {
      "start": 153.44,
      "end": 156.0,
      "text": "在升宽比十到十五的田孔效率上"
    },
    {
      "start": 156.0,
      "end": 157.52,
      "text": "已经超过了国际品牌"
    },
    {
      "start": 157.52,
      "end": 160.48,
      "text": "安吉科技则是电度业搭配泡光业一起上"
    },
    {
      "start": 160.48,
      "end": 163.16,
      "text": "大马市阁电度业已经进入量产阶段"
    },
    {
      "start": 163.16,
      "end": 165.92,
      "text": "上海新亚在中心国际这些前道经缘厂"
    },
    {
      "start": 165.92,
      "end": 167.2,
      "text": "也有正式业绩"
    },
    {
      "start": 167.2,
      "end": 169.52,
      "text": "电度业的營收和利润表现不错"
    },
    {
      "start": 169.52,
      "end": 172.2,
      "text": "天城科技的半岛体电度业也在同步放量"
    },
    {
      "start": 172.2,
      "end": 175.44,
      "text": "现在正和埃森在玻璃几万药水上积极推进"
    },
    {
      "start": 175.44,
      "end": 178.2,
      "text": "配套的嫌疑业国产化率大概在百分之十"
    },
    {
      "start": 178.2,
      "end": 180.0,
      "text": "格林达是国内的核心龙头"
    },
    {
      "start": 180.0,
      "end": 181.8,
      "text": "成结了国家专项公关"
    },
    {
      "start": 181.8,
      "end": 183.68,
      "text": "韩平验证已经进入伟伸"
    },
    {
      "start": 183.68,
      "end": 185.64,
      "text": "南大光电和同城新采"
    },
    {
      "start": 185.64,
      "end": 187.8,
      "text": "也有匹配自己光克交的嫌疑业"
    },
    {
      "start": 187.8,
      "end": 188.76,
      "text": "相较而言"
    },
    {
      "start": 188.76,
      "end": 191.8,
      "text": "化学机械抛光材料的国产化率稍微好看一点"
    },
    {
      "start": 191.8,
      "end": 193.56,
      "text": "大概在百分之五十左右"
    },
    {
      "start": 193.56,
      "end": 195.64,
      "text": "现在主要看先进制程的迭代"
    },
    {
      "start": 195.64,
      "end": 198.08,
      "text": "安级科技是国内泡光业的龙头"
    },
    {
      "start": 198.08,
      "end": 200.16,
      "text": "全球实际上率能到百分之十三"
    },
    {
      "start": 200.16,
      "end": 203.8,
      "text": "他们的先进风装用泡光业已经服务国内客户十二年了"
    },
    {
      "start": 203.8,
      "end": 207.44,
      "text": "目前规通孔和混合件和泡光业都已经拿到了定单"
    },
    {
      "start": 207.44,
      "end": 210.12,
      "text": "顶龙股份则是国内泡光店的绝对龙头"
    },
    {
      "start": 210.12,
      "end": 212.48,
      "text": "现在泡光业和清洗业也在快速上量"
    },
    {
      "start": 212.48,
      "end": 215.04,
      "text": "上海新洋这边则主要以规类泡光业为主"
    },
    {
      "start": 215.04,
      "end": 217.88,
      "text": "最后咱们聊聊高端填料和基本材料"
    },
    {
      "start": 217.88,
      "end": 220.8,
      "text": "这是人工只能驱动下性能升级的受益方向"
    },
    {
      "start": 220.8,
      "end": 222.76,
      "text": "一个是规微粉和氧化铝粉"
    },
    {
      "start": 222.76,
      "end": 224.64,
      "text": "在高代宽内存素风料里"
    },
    {
      "start": 224.64,
      "end": 229.24,
      "text": "这种DR法设现的球型规和球型铝成本站比能到百分之五十"
    },
    {
      "start": 229.24,
      "end": 231.48,
      "text": "但高端产品过去国产化很低"
    },
    {
      "start": 231.48,
      "end": 233.76,
      "text": "连锐芯材在这块是国内领先的"
    },
    {
      "start": 233.76,
      "end": 236.36,
      "text": "直接受益于国内供应链的高端化迭代"
    },
    {
      "start": 236.36,
      "end": 240.32,
      "text": "他们的DR法球规和球铝已经贡献了几千万元的收入"
    },
    {
      "start": 240.32,
      "end": 242.28,
      "text": "国资材料作为借质粉龙头"
    },
    {
      "start": 242.28,
      "end": 244.92,
      "text": "现在对接台系客户的速度也在加快"
    },
    {
      "start": 244.92,
      "end": 247.76,
      "text": "另一个大趋势是玻璃机板和相关的号彩"
    },
    {
      "start": 247.76,
      "end": 250.72,
      "text": "未来玻璃机板替代传统材质的趋势很明确"
    },
    {
      "start": 250.72,
      "end": 254.04,
      "text": "这里面的核心增量就是通孔电度药水和绝员层"
    },
    {
      "start": 254.04,
      "end": 257.56,
      "text": "艾森股份的玻璃通孔用光刻胶已经小批量放量"
    },
    {
      "start": 257.56,
      "end": 258.96,
      "text": "卡维优势很明显"
    },
    {
      "start": 258.96,
      "end": 261.6,
      "text": "天辰科技也披露了他们的玻璃通孔填孔"
    },
    {
      "start": 261.6,
      "end": 263.52,
      "text": "在电度加工效率和量率上"
    },
    {
      "start": 263.52,
      "end": 265.2,
      "text": "已经超过了某家国际品牌"
    },
    {
      "start": 265.2,
      "end": 268.32,
      "text": "此外聚合材料也在卡维也模板相关的基本"
    },
    {
      "start": 268.32,
      "end": 271.2,
      "text": "同样在享受风装层数增加带来的增量需求"
    },
    {
      "start": 271.2,
      "end": 272.96,
      "text": "其实把这些材料公司串下来"
    },
    {
      "start": 272.96,
      "end": 273.96,
      "text": "未来怎么看"
    },
    {
      "start": 273.96,
      "end": 275.4,
      "text": "逻辑非常清晰"
    },
    {
      "start": 275.4,
      "end": 276.76,
      "text": "主要就三条主线"
    },
    {
      "start": 276.76,
      "end": 280.52,
      "text": "第一条是高带宽内存核心机彩从零到一的突破"
    },
    {
      "start": 280.52,
      "end": 284.36,
      "text": "这就是花海城科的速封料和华正新才的再版数值"
    },
    {
      "start": 284.36,
      "end": 287.2,
      "text": "这两家是在解决最核心的卡脖子问题"
    },
    {
      "start": 287.2,
      "end": 289.24,
      "text": "享受的是极高的稀缺性异价"
    },
    {
      "start": 289.24,
      "end": 292.84,
      "text": "第二条是黄光和电度号材的国产核心地位确立"
    },
    {
      "start": 292.84,
      "end": 294.44,
      "text": "代表就是艾森股份"
    },
    {
      "start": 294.44,
      "end": 296.32,
      "text": "即使风装光刻胶的核心"
    },
    {
      "start": 296.32,
      "end": 298.64,
      "text": "又是电度业的第一供应上"
    },
    {
      "start": 298.64,
      "end": 302.68,
      "text": "在长新和长存的国内存储链里确定性最强"
    },
    {
      "start": 302.68,
      "end": 305.0,
      "text": "第三条就是半岁人工智能性能升级"
    },
    {
      "start": 305.0,
      "end": 306.76,
      "text": "带来的材料价值量提升"
    },
    {
      "start": 306.76,
      "end": 308.24,
      "text": "向连锐心彩的高端球"
    },
    {
      "start": 308.24,
      "end": 309.28,
      "text": "归球驴"
    },
    {
      "start": 309.28,
      "end": 312.12,
      "text": "还有安级科技的规通孔和轰合件核胞光业"
    },
    {
      "start": 312.12,
      "end": 315.04,
      "text": "属于从能封装向高性能封装眼镜的受益者"
    },
    {
      "start": 315.04,
      "end": 317.64,
      "text": "材料这块的水确实比设备还要深"
    },
    {
      "start": 317.64,
      "end": 320.36,
      "text": "里面这些公司的身位和进度也各有不同"
    },
    {
      "start": 320.36,
      "end": 323.56,
      "text": "今天先跟你把这些核心标记的卡位顺道者"
    },
    {
      "start": 323.56,
      "end": 326.64,
      "text": "后面就看谁的客户端放量数据先跑出来了"
    },
    {
      "start": 326.64,
      "end": 328.24,
      "text": "等郭镇子有新的变化"
    },
    {
      "start": 328.24,
      "end": 329.96,
      "text": "咱们在约时间继续细盘"
    }
  ]
}