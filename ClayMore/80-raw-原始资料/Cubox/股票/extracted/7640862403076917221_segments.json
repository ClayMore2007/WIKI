{
  "language": "zh",
  "duration": 288.2060625,
  "segments": [
    {
      "start": 0.0,
      "end": 1.8,
      "text": "大家好 今天聊一聊"
    },
    {
      "start": 1.8,
      "end": 5.36,
      "text": "MicroLED超短剧光通信搭配玻璃机板"
    },
    {
      "start": 5.36,
      "end": 7.36,
      "text": "绝对是当下AI数据中心"
    },
    {
      "start": 7.36,
      "end": 9.76,
      "text": "光进同退趋势里的绝家组合"
    },
    {
      "start": 9.76,
      "end": 13.2,
      "text": "目前英伟达 台积电 英特尔行业三大头部企业"
    },
    {
      "start": 13.2,
      "end": 15.08,
      "text": "都已经权力入局布局"
    },
    {
      "start": 15.08,
      "end": 17.12,
      "text": "首先说清楚两者之间的核心关系"
    },
    {
      "start": 17.12,
      "end": 17.8,
      "text": "特别好理解"
    },
    {
      "start": 17.8,
      "end": 20.32,
      "text": "MicroLED就是负责发出光信号"
    },
    {
      "start": 20.32,
      "end": 23.04,
      "text": "完成高速数据传输的核心布件"
    },
    {
      "start": 23.04,
      "end": 24.44,
      "text": "相当于动力核心"
    },
    {
      "start": 24.44,
      "end": 27.64,
      "text": "而玻璃机板就是稳固可靠的成宅底座"
    },
    {
      "start": 27.64,
      "end": 30.08,
      "text": "负责安放芯片搭建互联线路"
    },
    {
      "start": 30.08,
      "end": 32.08,
      "text": "二者相符相成缺义不可"
    },
    {
      "start": 32.08,
      "end": 34.72,
      "text": "早前各达AI服期内部GPU之间"
    },
    {
      "start": 34.72,
      "end": 36.08,
      "text": "各类芯片之间"
    },
    {
      "start": 36.08,
      "end": 38.2,
      "text": "10米以内的近距离数据传输"
    },
    {
      "start": 38.2,
      "end": 40.28,
      "text": "基本都依靠传统同蓝完成"
    },
    {
      "start": 40.28,
      "end": 42.64,
      "text": "但现在高端AI芯片功耗越来越高"
    },
    {
      "start": 42.64,
      "end": 44.36,
      "text": "同蓝传输速度一提升"
    },
    {
      "start": 44.36,
      "end": 47.0,
      "text": "不仅发热严重整体功耗也居高不下"
    },
    {
      "start": 47.0,
      "end": 49.52,
      "text": "同等传输速率下能耗成本太高"
    },
    {
      "start": 49.52,
      "end": 51.48,
      "text": "如果选用传统激光传输方案"
    },
    {
      "start": 51.48,
      "end": 52.88,
      "text": "不仅采购成本高"
    },
    {
      "start": 52.88,
      "end": 54.8,
      "text": "还需要额外配套温控设备"
    },
    {
      "start": 54.92,
      "end": 57.12,
      "text": "整体使用起来麻烦又不划算"
    },
    {
      "start": 57.12,
      "end": 60.28,
      "text": "而MicroLED技术恰好补弃了这些短板"
    },
    {
      "start": 60.28,
      "end": 62.84,
      "text": "依靠微米极发光镇烈实现信号传输"
    },
    {
      "start": 62.84,
      "end": 65.56,
      "text": "不需要激光光源也不用额外温控设备"
    },
    {
      "start": 65.56,
      "end": 67.96,
      "text": "高低温复杂环境下都能稳定运行"
    },
    {
      "start": 67.96,
      "end": 68.84,
      "text": "最大优势就是"
    },
    {
      "start": 68.84,
      "end": 71.28,
      "text": "功耗及低传输同等贷宽数据"
    },
    {
      "start": 71.28,
      "end": 73.08,
      "text": "能耗远远低于传统同蓝"
    },
    {
      "start": 73.08,
      "end": 75.76,
      "text": "同时还能实现多路信号同步传输"
    },
    {
      "start": 75.76,
      "end": 77.84,
      "text": "贷宽容量完全能够满足当下"
    },
    {
      "start": 77.84,
      "end": 80.88,
      "text": "高端算令设备的近距离通信需求"
    },
    {
      "start": 80.88,
      "end": 83.32,
      "text": "不过这种微型高密度芯片震烈"
    },
    {
      "start": 83.32,
      "end": 85.76,
      "text": "对存在板材的要求格外严科"
    },
    {
      "start": 85.76,
      "end": 87.8,
      "text": "我们常用的传动下路板材"
    },
    {
      "start": 87.8,
      "end": 89.96,
      "text": "遇到高温容易变形敲取"
    },
    {
      "start": 89.96,
      "end": 91.32,
      "text": "板面平整度不足"
    },
    {
      "start": 91.32,
      "end": 93.72,
      "text": "也无法制作高密度惊喜下路"
    },
    {
      "start": 93.72,
      "end": 96.36,
      "text": "根本适配不了MicroLED的使用需求"
    },
    {
      "start": 96.36,
      "end": 98.92,
      "text": "这时候玻璃机板的优势就彻底体现出来了"
    },
    {
      "start": 98.92,
      "end": 100.44,
      "text": "板面平整性极加"
    },
    {
      "start": 100.44,
      "end": 102.76,
      "text": "热膨脏系数和芯片高度气质"
    },
    {
      "start": 102.76,
      "end": 105.52,
      "text": "长时间使用不会出现变形拖汗的情况"
    },
    {
      "start": 105.52,
      "end": 107.0,
      "text": "那高温稳定性极强"
    },
    {
      "start": 107.0,
      "end": 109.64,
      "text": "不仅能够制作超细高密度下路"
    },
    {
      "start": 109.64,
      "end": 112.44,
      "text": "还可以通过玻璃通统供应实现垂直互联"
    },
    {
      "start": 112.44,
      "end": 114.2,
      "text": "顺畅传导光信号"
    },
    {
      "start": 114.2,
      "end": 117.4,
      "text": "也是唯一能够适配MicroLED大规模机程"
    },
    {
      "start": 117.4,
      "end": 120.0,
      "text": "长久稳定运行的优质机彩"
    },
    {
      "start": 120.0,
      "end": 121.12,
      "text": "看完技术优势"
    },
    {
      "start": 121.12,
      "end": 124.28,
      "text": "我们再看看行业头部企业的实际布局进展"
    },
    {
      "start": 124.28,
      "end": 125.32,
      "text": "先说到应委达"
    },
    {
      "start": 125.32,
      "end": 127.48,
      "text": "作为AI算力领域的龙头企业"
    },
    {
      "start": 127.48,
      "end": 129.36,
      "text": "早已确定技术应用方向"
    },
    {
      "start": 129.36,
      "end": 133.08,
      "text": "明确将MicroLED结合共丰装光学技术"
    },
    {
      "start": 133.08,
      "end": 135.2,
      "text": "定为新一代高端AI芯片"
    },
    {
      "start": 135.2,
      "end": 137.0,
      "text": "进距离互联的主流方案"
    },
    {
      "start": 137.0,
      "end": 138.68,
      "text": "目前已经鞋手合作企业"
    },
    {
      "start": 138.68,
      "end": 141.2,
      "text": "推进技术整合与样品测试工作"
    },
    {
      "start": 141.2,
      "end": 143.32,
      "text": "敲定整体技术应用标准"
    },
    {
      "start": 143.32,
      "end": 147.64,
      "text": "计划在2027-2028年正式实现规模化商用落地"
    },
    {
      "start": 147.64,
      "end": 148.64,
      "text": "再来看台积电"
    },
    {
      "start": 148.64,
      "end": 150.84,
      "text": "据交底层封装与极成领域"
    },
    {
      "start": 150.84,
      "end": 154.44,
      "text": "一边整合自身成熟的规光技术与堆疊工艺"
    },
    {
      "start": 154.44,
      "end": 157.16,
      "text": "优化MicroLED芯片极成方案"
    },
    {
      "start": 157.16,
      "end": 160.56,
      "text": "另一边全力推进玻璃基本新型封装技术落地"
    },
    {
      "start": 160.56,
      "end": 163.84,
      "text": "搭建专属实验产现稳部推进产能建设"
    },
    {
      "start": 163.84,
      "end": 166.36,
      "text": "预计在2028年前后实现大批浪量产"
    },
    {
      "start": 166.36,
      "end": 169.6,
      "text": "为各大算力企业供应配套封装产品"
    },
    {
      "start": 169.6,
      "end": 171.72,
      "text": "最后是应可不举节奏最为迅速"
    },
    {
      "start": 171.72,
      "end": 174.72,
      "text": "早已投入重金搭建专业生产产现"
    },
    {
      "start": 174.72,
      "end": 177.6,
      "text": "早早实现了商用级玻璃基本的量产落地"
    },
    {
      "start": 177.6,
      "end": 180.16,
      "text": "再先应用在旗下高端处理器产品当中"
    },
    {
      "start": 180.16,
      "end": 182.68,
      "text": "评计成熟的玻璃机财制造经验"
    },
    {
      "start": 182.68,
      "end": 185.08,
      "text": "大幅优化板材使用性能"
    },
    {
      "start": 185.08,
      "end": 187.36,
      "text": "有效降低板材形链问题"
    },
    {
      "start": 187.36,
      "end": 190.8,
      "text": "为整个行业MicroLED光通性技术普及"
    },
    {
      "start": 190.8,
      "end": 192.72,
      "text": "驻牢了坚实的材料基础"
    },
    {
      "start": 192.72,
      "end": 194.88,
      "text": "整体书理下来分工十分清晰"
    },
    {
      "start": 194.92,
      "end": 199.08,
      "text": "MicroLED主供低能耗高密度高速数据传输"
    },
    {
      "start": 199.08,
      "end": 202.64,
      "text": "解决算力设备近距离通信的能耗与速度难提"
    },
    {
      "start": 202.64,
      "end": 206.24,
      "text": "玻璃基本主打高稳定性高密度集成互联"
    },
    {
      "start": 206.24,
      "end": 209.48,
      "text": "解决芯片安放与长久使用的材质痛点"
    },
    {
      "start": 209.48,
      "end": 212.44,
      "text": "英伟达敲定应用标准与落地场景"
    },
    {
      "start": 212.44,
      "end": 214.92,
      "text": "台积电身功底层集成封装制造"
    },
    {
      "start": 214.92,
      "end": 217.52,
      "text": "应可率先实现核心材料量产突破"
    },
    {
      "start": 217.52,
      "end": 220.12,
      "text": "三方合力推动整条产业量快速成熟"
    },
    {
      "start": 220.12,
      "end": 222.64,
      "text": "按照目前行业整体发展节奏来看"
    },
    {
      "start": 222.68,
      "end": 225.16,
      "text": "今年主要以产品测试技术验证为主"
    },
    {
      "start": 225.16,
      "end": 228.28,
      "text": "明年进入小批量市产阶段等到2028年"
    },
    {
      "start": 228.28,
      "end": 231.4,
      "text": "整条产业量有望迎来全面规模化量产"
    },
    {
      "start": 231.4,
      "end": 233.12,
      "text": "整体市场发展前例可观"
    },
    {
      "start": 233.12,
      "end": 237.16,
      "text": "往后两年MicroLED搭配玻璃机板的组合应用"
    },
    {
      "start": 237.16,
      "end": 239.8,
      "text": "一定会成为行业热义的主流方向"
    },
    {
      "start": 239.8,
      "end": 242.08,
      "text": "二者深度绑定鞋通发展"
    },
    {
      "start": 242.08,
      "end": 245.12,
      "text": "也将持续推动AI数据中心完成"
    },
    {
      "start": 245.12,
      "end": 247.32,
      "text": "从电信号传输到光信号传输"
    },
    {
      "start": 247.32,
      "end": 250.24,
      "text": "从传统有机板材向高端无机"
    },
    {
      "start": 250.24,
      "end": 252.52,
      "text": "玻璃机材的全面产业升级"
    },
    {
      "start": 252.56,
      "end": 255.4,
      "text": "最后客观提醒行业技术落地到批量生产"
    },
    {
      "start": 255.4,
      "end": 257.8,
      "text": "还需要一定周期大家理性看待行业节奏"
    },
    {
      "start": 257.8,
      "end": 259.28,
      "text": "合理把控投资节奏"
    },
    {
      "start": 259.28,
      "end": 261.36,
      "text": "评论区可以聊聊相关上市公司"
    },
    {
      "start": 261.36,
      "end": 262.52,
      "text": "正重跟大家提醒"
    },
    {
      "start": 262.52,
      "end": 265.12,
      "text": "今天所有内容都是基于公开行业信息"
    },
    {
      "start": 265.12,
      "end": 267.44,
      "text": "的产业逻辑科普和赛道书里"
    },
    {
      "start": 267.44,
      "end": 268.88,
      "text": "尽作为行业交流分享"
    },
    {
      "start": 268.88,
      "end": 270.4,
      "text": "不涉及任何各股推荐"
    },
    {
      "start": 270.4,
      "end": 272.36,
      "text": "也绝不够成任何投资建议"
    },
    {
      "start": 272.36,
      "end": 275.8,
      "text": "大家千万不要紧平科普内容盲目参与交易"
    },
    {
      "start": 275.8,
      "end": 276.68,
      "text": "市场有风险"
    },
    {
      "start": 276.68,
      "end": 278.08,
      "text": "投资一定要保持理性"
    },
    {
      "start": 278.08,
      "end": 278.72,
      "text": "独立判断"
    },
    {
      "start": 278.72,
      "end": 281.4,
      "text": "如果觉得今天的半脑体干活内容对你有帮助"
    },
    {
      "start": 281.4,
      "end": 283.08,
      "text": "欢迎点赞,关注,评论"
    },
    {
      "start": 283.08,
      "end": 285.12,
      "text": "咱们下期继续聊应和产业逻辑"
    }
  ]
