{
  "language": "zh",
  "duration": 656.219125,
  "segments": [
    {
      "start": 0.0,
      "end": 1.2,
      "text": "什么是物理AI"
    },
    {
      "start": 1.2,
      "end": 3.0,
      "text": "物理AI就是机器人吗"
    },
    {
      "start": 3.0,
      "end": 4.8,
      "text": "物理AI进家安全吗"
    },
    {
      "start": 4.8,
      "end": 7.6,
      "text": "一些职业最先被物理AI替代"
    },
    {
      "start": 7.6,
      "end": 9.0,
      "text": "物理AI靠什么"
    },
    {
      "start": 9.0,
      "end": 10.4,
      "text": "看懂现实世界"
    },
    {
      "start": 10.4,
      "end": 13.0,
      "text": "物理AI需要连网才能用吗"
    },
    {
      "start": 13.0,
      "end": 16.0,
      "text": "入局物理AI塞到该选那些标地"
    },
    {
      "start": 16.0,
      "end": 18.6,
      "text": "今天这条深度视频物地就一个"
    },
    {
      "start": 18.6,
      "end": 21.4,
      "text": "让你彻底理解什么是物理AI"
    },
    {
      "start": 21.4,
      "end": 24.4,
      "text": "在这条未来的万一及新兴产业练理"
    },
    {
      "start": 24.4,
      "end": 27.4,
      "text": "又有哪些核心上市公司值得关注"
    },
    {
      "start": 27.4,
      "end": 29.6,
      "text": "我会用最通俗的逻辑"
    },
    {
      "start": 29.6,
      "end": 30.6,
      "text": "最落地的理解"
    },
    {
      "start": 30.6,
      "end": 33.8,
      "text": "让你彻底吃透物理AI这个概念"
    },
    {
      "start": 33.8,
      "end": 36.0,
      "text": "以后再不用刷碎片化内容"
    },
    {
      "start": 36.0,
      "end": 39.4,
      "text": "并助理你在封口来零前站门脚跟"
    },
    {
      "start": 39.4,
      "end": 41.2,
      "text": "首先来搞懂的第一个问题"
    },
    {
      "start": 41.2,
      "end": 43.6,
      "text": "什么是物理AI"
    },
    {
      "start": 43.6,
      "end": 45.0,
      "text": "物理AI英文"
    },
    {
      "start": 45.0,
      "end": 46.0,
      "text": "Fysical AI"
    },
    {
      "start": 46.0,
      "end": 48.4,
      "text": "并非一个平空创造的概念"
    },
    {
      "start": 48.4,
      "end": 49.8,
      "text": "根据黄人薰的产数"
    },
    {
      "start": 49.8,
      "end": 51.0,
      "text": "物理AI是指"
    },
    {
      "start": 51.0,
      "end": 52.8,
      "text": "能够理解现实世界"
    },
    {
      "start": 52.8,
      "end": 55.2,
      "text": "并与知进行交互的AI模型"
    },
    {
      "start": 55.2,
      "end": 58.0,
      "text": "是一种使自主机器如机器人"
    },
    {
      "start": 58.0,
      "end": 59.4,
      "text": "自动架使器车等"
    },
    {
      "start": 59.4,
      "end": 61.0,
      "text": "在真实物理世界中"
    },
    {
      "start": 61.0,
      "end": 64.8,
      "text": "感知理解和执行复杂操作的技术"
    },
    {
      "start": 64.8,
      "end": 65.8,
      "text": "简单来说"
    },
    {
      "start": 65.8,
      "end": 67.4,
      "text": "传统大圆模型"
    },
    {
      "start": 67.4,
      "end": 70.2,
      "text": "擅长理解和声承文字图像"
    },
    {
      "start": 70.2,
      "end": 71.8,
      "text": "但他们困在屏幕里"
    },
    {
      "start": 71.8,
      "end": 74.6,
      "text": "对现实世界中的重力抹擦力"
    },
    {
      "start": 74.6,
      "end": 77.0,
      "text": "空间关系等物理规律一跳不通"
    },
    {
      "start": 77.0,
      "end": 77.8,
      "text": "而物理AI"
    },
    {
      "start": 77.8,
      "end": 79.3,
      "text": "则要把AI从屏幕里"
    },
    {
      "start": 79.3,
      "end": 81.1,
      "text": "拽出来给它一句身体"
    },
    {
      "start": 81.1,
      "end": 82.6,
      "text": "让它进入真实世界"
    },
    {
      "start": 82.6,
      "end": 84.0,
      "text": "去理解这些规律"
    },
    {
      "start": 84.0,
      "end": 88.6,
      "text": "并拥有感知、推理、行动、反馈的闭环能力"
    },
    {
      "start": 88.6,
      "end": 89.6,
      "text": "它不仅会思考"
    },
    {
      "start": 89.6,
      "end": 91.24,
      "text": "更能通过机器人等"
    },
    {
      "start": 91.24,
      "end": 93.0,
      "text": "据身设备执行任务"
    },
    {
      "start": 93.0,
      "end": 96.8,
      "text": "并从真实反馈中持续纠错自我进化"
    },
    {
      "start": 96.8,
      "end": 98.3,
      "text": "搞懂了什么是物理AI"
    },
    {
      "start": 98.3,
      "end": 100.3,
      "text": "我们再来看物理AI的组成"
    },
    {
      "start": 100.3,
      "end": 101.8,
      "text": "主要分三个系统"
    },
    {
      "start": 101.8,
      "end": 103.5,
      "text": "分别是感知系统"
    },
    {
      "start": 103.5,
      "end": 104.5,
      "text": "绝测系统"
    },
    {
      "start": 104.5,
      "end": 105.5,
      "text": "执行系统"
    },
    {
      "start": 105.5,
      "end": 106.3,
      "text": "感知系统"
    },
    {
      "start": 106.3,
      "end": 107.3,
      "text": "通过传感器"
    },
    {
      "start": 107.3,
      "end": 108.2,
      "text": "激光雷达"
    },
    {
      "start": 108.2,
      "end": 109.3,
      "text": "摄像头等设备"
    },
    {
      "start": 109.3,
      "end": 110.8,
      "text": "采集环境信息"
    },
    {
      "start": 110.8,
      "end": 113.0,
      "text": "将物理世界的多摩探信号"
    },
    {
      "start": 113.0,
      "end": 115.5,
      "text": "转化为AI可理解的数据"
    },
    {
      "start": 115.5,
      "end": 118.3,
      "text": "这相当于机器人的眼睛和皮膚"
    },
    {
      "start": 118.4,
      "end": 119.4,
      "text": "决测系统"
    },
    {
      "start": 119.4,
      "end": 121.1,
      "text": "以世界模型为核心"
    },
    {
      "start": 121.1,
      "end": 124.2,
      "text": "在理解和预测物理规律的基础上"
    },
    {
      "start": 124.2,
      "end": 126.0,
      "text": "做出行动规划"
    },
    {
      "start": 126.0,
      "end": 127.7,
      "text": "与传统的数字AI不同"
    },
    {
      "start": 127.7,
      "end": 128.8,
      "text": "物理AI的决测"
    },
    {
      "start": 128.8,
      "end": 131.0,
      "text": "必须在不确定性下进行"
    },
    {
      "start": 131.0,
      "end": 135.4,
      "text": "前要考虑重力、惯性、碰撞等物理约束"
    },
    {
      "start": 135.4,
      "end": 138.5,
      "text": "因为达在CES2020-26上发布的开源"
    },
    {
      "start": 138.5,
      "end": 140.2,
      "text": "世界模型Costmos"
    },
    {
      "start": 140.2,
      "end": 143.6,
      "text": "通过超2000万小时的物理世界数据训练"
    },
    {
      "start": 143.6,
      "end": 144.7,
      "text": "内置了碰撞"
    },
    {
      "start": 144.7,
      "end": 147.7,
      "text": "重力等基础物理规律的理解能力"
    },
    {
      "start": 147.7,
      "end": 151.7,
      "text": "是目前物理AI领域最重要的基础平台之一"
    },
    {
      "start": 151.7,
      "end": 155.8,
      "text": "执行系统通过电机、减速器、思钢等执行机构"
    },
    {
      "start": 155.8,
      "end": 159.4,
      "text": "将决测转化为物理世界的实际动作"
    },
    {
      "start": 159.4,
      "end": 162.2,
      "text": "这是从数字到实体的最后一环"
    },
    {
      "start": 162.2,
      "end": 165.1,
      "text": "也是最考验工程能力的环节"
    },
    {
      "start": 165.1,
      "end": 167.8,
      "text": "当你搞懂了物理AI的定义和组成系统"
    },
    {
      "start": 167.8,
      "end": 168.7,
      "text": "那你就会明白"
    },
    {
      "start": 168.7,
      "end": 170.8,
      "text": "物理AI和现有AI的关系"
    },
    {
      "start": 170.8,
      "end": 173.6,
      "text": "物理AI不是对生成是AI的替代"
    },
    {
      "start": 173.6,
      "end": 176.0,
      "text": "而是其延伸和升级"
    },
    {
      "start": 176.0,
      "end": 179.0,
      "text": "黄人讯将AI的发展划分为三个阶段"
    },
    {
      "start": 179.0,
      "end": 184.2,
      "text": "第一阶段是理解和生成数字内容的AI如大约模型"
    },
    {
      "start": 184.2,
      "end": 188.9,
      "text": "第二阶段是能在数字世界中自主行动的Agentic AI"
    },
    {
      "start": 188.9,
      "end": 194.4,
      "text": "第三阶段就是能在物理世界中感知绝测和执行的物理AI"
    },
    {
      "start": 194.4,
      "end": 196.9,
      "text": "至于物理AI与机器人的关系"
    },
    {
      "start": 196.9,
      "end": 200.3,
      "text": "前者提供大脑理解物理规律的模型"
    },
    {
      "start": 200.3,
      "end": 203.4,
      "text": "后者提供身体执行任务的硬件载体"
    },
    {
      "start": 203.4,
      "end": 205.9,
      "text": "二者相符相承缺一不可"
    },
    {
      "start": 205.9,
      "end": 208.9,
      "text": "接下来我们分析物理AI的实际应用场景"
    },
    {
      "start": 208.9,
      "end": 210.9,
      "text": "当前物理AI的市场规模预测"
    },
    {
      "start": 210.9,
      "end": 212.2,
      "text": "所以各有差异"
    },
    {
      "start": 212.2,
      "end": 214.5,
      "text": "但市场共时高度一致"
    },
    {
      "start": 214.5,
      "end": 217.8,
      "text": "这将会是一个万亿级的庞大市场"
    },
    {
      "start": 217.8,
      "end": 220.0,
      "text": "根据Future Martis Inc的报告"
    },
    {
      "start": 220.0,
      "end": 223.6,
      "text": "涵盖自主机器人自动驾驶汽车人型系统"
    },
    {
      "start": 223.6,
      "end": 226.6,
      "text": "工业自动化的全球物理AI市场"
    },
    {
      "start": 226.6,
      "end": 230.3,
      "text": "预计将从2026年的约3831美元"
    },
    {
      "start": 230.3,
      "end": 233.6,
      "text": "增长到2040年的3.26万亿美元"
    },
    {
      "start": 233.6,
      "end": 235.8,
      "text": "14年10倍增幅"
    },
    {
      "start": 235.8,
      "end": 238.3,
      "text": "多家头部机构对自动驾驶市场的预测"
    },
    {
      "start": 238.3,
      "end": 239.4,
      "text": "由为乐观"
    },
    {
      "start": 239.4,
      "end": 243.6,
      "text": "预计到2030年将超过2100亿美元"
    },
    {
      "start": 243.6,
      "end": 245.44,
      "text": "因为达发布专用于复杂"
    },
    {
      "start": 245.44,
      "end": 247.3,
      "text": "道路推理的物理AI模型"
    },
    {
      "start": 247.3,
      "end": 248.1,
      "text": "Alpomeo"
    },
    {
      "start": 248.1,
      "end": 250.2,
      "text": "以于比亚迪、Uber等企业"
    },
    {
      "start": 250.2,
      "end": 251.8,
      "text": "部署Robotaxi网络"
    },
    {
      "start": 251.8,
      "end": 254.0,
      "text": "全球最大的汽车生产商封铁"
    },
    {
      "start": 254.0,
      "end": 256.5,
      "text": "也正计化用英伟达的Cosmos"
    },
    {
      "start": 256.5,
      "end": 259.3,
      "text": "来开发下一代自动驾驶系统"
    },
    {
      "start": 259.3,
      "end": 260.5,
      "text": "而在物流领域"
    },
    {
      "start": 260.5,
      "end": 265.1,
      "text": "FigureAI机器人实现了超过100小时的连续工作直播"
    },
    {
      "start": 265.2,
      "end": 268.0,
      "text": "单台持续工作超33小时"
    },
    {
      "start": 268.0,
      "end": 271.0,
      "text": "分剪效率达到人工的1.8倍"
    },
    {
      "start": 271.0,
      "end": 274.5,
      "text": "不规则包裹实别率达到99.7"
    },
    {
      "start": 274.5,
      "end": 277.8,
      "text": "条码放置成功率超过95%"
    },
    {
      "start": 277.8,
      "end": 280.8,
      "text": "这意味着在仓处物流等高频场景"
    },
    {
      "start": 280.8,
      "end": 285.1,
      "text": "人型机器人已经具备了超越人工的经济性和稳定性"
    },
    {
      "start": 285.1,
      "end": 285.9,
      "text": "在国内"
    },
    {
      "start": 285.9,
      "end": 288.4,
      "text": "志愿机器人在南昌3C产线上"
    },
    {
      "start": 288.4,
      "end": 291.0,
      "text": "完成了连续数小时的直播作业"
    },
    {
      "start": 291.0,
      "end": 294.0,
      "text": "优弊选机器人以规模化进入比亚迪"
    },
    {
      "start": 294.1,
      "end": 295.9,
      "text": "富士康等头部企业"
    },
    {
      "start": 295.9,
      "end": 298.9,
      "text": "执行装配、制检、搬运等任务"
    },
    {
      "start": 298.9,
      "end": 300.9,
      "text": "众情机器人在多地路口"
    },
    {
      "start": 300.9,
      "end": 302.9,
      "text": "承担交通指挥与安防巡罗"
    },
    {
      "start": 302.9,
      "end": 304.7,
      "text": "使和科技的特种机器人"
    },
    {
      "start": 304.7,
      "end": 308.7,
      "text": "则进入了化工、储罐、传播、修造等高危场景"
    },
    {
      "start": 308.7,
      "end": 310.7,
      "text": "替代人工完成储秀"
    },
    {
      "start": 310.7,
      "end": 312.7,
      "text": "打磨等危险作业"
    },
    {
      "start": 312.7,
      "end": 314.7,
      "text": "从物流分解到工厂制造"
    },
    {
      "start": 314.7,
      "end": 317.1,
      "text": "从自动驾驶到家庭服务"
    },
    {
      "start": 317.1,
      "end": 320.7,
      "text": "物理AI的落地场景正在快速扩大"
    },
    {
      "start": 320.7,
      "end": 322.7,
      "text": "接下来就是大家最关心的"
    },
    {
      "start": 322.7,
      "end": 325.7,
      "text": "物理AI产业链上都有哪些核心环节"
    },
    {
      "start": 325.7,
      "end": 327.7,
      "text": "利润负集的核心环节上"
    },
    {
      "start": 327.7,
      "end": 330.4,
      "text": "国内又有哪些公司提前布局"
    },
    {
      "start": 330.4,
      "end": 331.9,
      "text": "具2026年5月"
    },
    {
      "start": 331.9,
      "end": 333.9,
      "text": "欧洲飞速AI产业报告"
    },
    {
      "start": 333.9,
      "end": 335.8,
      "text": "物理AI产业链横跨"
    },
    {
      "start": 335.8,
      "end": 336.7,
      "text": "访真软件"
    },
    {
      "start": 336.7,
      "end": 338.9,
      "text": "大模型、算力、传感器"
    },
    {
      "start": 338.9,
      "end": 340.1,
      "text": "精密执行器等"
    },
    {
      "start": 340.1,
      "end": 343.2,
      "text": "链条极厂各环节专业庇类极高"
    },
    {
      "start": 343.2,
      "end": 344.7,
      "text": "其中访真平台"
    },
    {
      "start": 344.7,
      "end": 346.4,
      "text": "基础模型庇类最高"
    },
    {
      "start": 346.4,
      "end": 349.6,
      "text": "各自占据产业链价值的20%"
    },
    {
      "start": 349.6,
      "end": 352.4,
      "text": "其次数据中心计算占15%"
    },
    {
      "start": 352.4,
      "end": 353.6,
      "text": "边缘计算"
    },
    {
      "start": 353.6,
      "end": 356.1,
      "text": "内存、执行器、三大环节"
    },
    {
      "start": 356.1,
      "end": 358.3,
      "text": "均各占约10%"
    },
    {
      "start": 358.3,
      "end": 360.3,
      "text": "各环节的价值占比排序为"
    },
    {
      "start": 360.3,
      "end": 362.4,
      "text": "访真平台大于基础模型"
    },
    {
      "start": 362.4,
      "end": 363.8,
      "text": "大于专用算力"
    },
    {
      "start": 363.8,
      "end": 365.2,
      "text": "大于精密执行器"
    },
    {
      "start": 365.2,
      "end": 366.6,
      "text": "大于传感器"
    },
    {
      "start": 366.6,
      "end": 367.8,
      "text": "其中底层软件"
    },
    {
      "start": 367.8,
      "end": 370.5,
      "text": "与模型几乎被海外拐头壟断"
    },
    {
      "start": 370.5,
      "end": 372.3,
      "text": "国产替代难度最大"
    },
    {
      "start": 372.3,
      "end": 374.4,
      "text": "1.底层世界模型"
    },
    {
      "start": 374.4,
      "end": 375.8,
      "text": "与访真平台"
    },
    {
      "start": 375.8,
      "end": 379.3,
      "text": "世界模型是整个物理AI生态的操作系统"
    },
    {
      "start": 379.3,
      "end": 382.3,
      "text": "主要包括可微分物理访真平台"
    },
    {
      "start": 382.3,
      "end": 385.2,
      "text": "底层算力芯片以及工业软件"
    },
    {
      "start": 385.2,
      "end": 387.8,
      "text": "访真平台是物理AI训练的"
    },
    {
      "start": 387.8,
      "end": 389.2,
      "text": "数字训练厂"
    },
    {
      "start": 389.2,
      "end": 392.0,
      "text": "决定了物理AI能力的上线"
    },
    {
      "start": 392.0,
      "end": 392.7,
      "text": "在这方面"
    },
    {
      "start": 392.7,
      "end": 393.9,
      "text": "因为达的Cosmos"
    },
    {
      "start": 393.9,
      "end": 395.2,
      "text": "以1000亿参数"
    },
    {
      "start": 395.2,
      "end": 397.7,
      "text": "达成1毫秒级推理延迟"
    },
    {
      "start": 397.7,
      "end": 400.4,
      "text": "支持多摩泰物理世界理解"
    },
    {
      "start": 400.4,
      "end": 401.8,
      "text": "国内具有代表性的企业"
    },
    {
      "start": 401.8,
      "end": 402.8,
      "text": "有所成科技"
    },
    {
      "start": 402.8,
      "end": 405.6,
      "text": "2025年其物理AI核心平台"
    },
    {
      "start": 405.6,
      "end": 407.4,
      "text": "天空开物实现落地"
    },
    {
      "start": 407.4,
      "end": 409.7,
      "text": "收入5,816万元"
    },
    {
      "start": 409.7,
      "end": 413.1,
      "text": "率先在低空理域形成商业化突破"
    },
    {
      "start": 413.1,
      "end": 415.6,
      "text": "五一世界近期发布了全球手款"
    },
    {
      "start": 415.6,
      "end": 417.6,
      "text": "物理直觉世界模型"
    },
    {
      "start": 417.6,
      "end": 419.0,
      "text": "旗下51cm"
    },
    {
      "start": 419.0,
      "end": 420.9,
      "text": "占据国内高阶智能价时"
    },
    {
      "start": 420.9,
      "end": 423.6,
      "text": "访真市场53.5%的份额"
    },
    {
      "start": 423.6,
      "end": 426.5,
      "text": "被市场视为物理AI第一股"
    },
    {
      "start": 426.5,
      "end": 430.0,
      "text": "2.感知层传感器于视觉"
    },
    {
      "start": 430.0,
      "end": 434.3,
      "text": "传感器是物理AI感知世界的眼睛和皮膚"
    },
    {
      "start": 434.3,
      "end": 435.8,
      "text": "在传感器体系中"
    },
    {
      "start": 435.8,
      "end": 437.2,
      "text": "3D视觉感知"
    },
    {
      "start": 437.2,
      "end": 439.4,
      "text": "激光雷达和力觉传感器"
    },
    {
      "start": 439.4,
      "end": 441.9,
      "text": "构成了三大核心支柱"
    },
    {
      "start": 441.9,
      "end": 444.1,
      "text": "3D视觉是实现空间剑膜"
    },
    {
      "start": 444.1,
      "end": 445.9,
      "text": "和场景理解的核心入口"
    },
    {
      "start": 445.9,
      "end": 449.3,
      "text": "尤其在人形机器人和服务机器人领域"
    },
    {
      "start": 449.3,
      "end": 451.4,
      "text": "其地位正在从可选组件"
    },
    {
      "start": 451.4,
      "end": 454.1,
      "text": "升级为钢性基础设施"
    },
    {
      "start": 454.1,
      "end": 455.4,
      "text": "奥比中光作为国内"
    },
    {
      "start": 455.4,
      "end": 457.2,
      "text": "3D视觉感知龙头"
    },
    {
      "start": 457.2,
      "end": 458.8,
      "text": "其机器人视觉业务"
    },
    {
      "start": 458.8,
      "end": 461.2,
      "text": "在中国服务机器人市场战友率"
    },
    {
      "start": 461.2,
      "end": 463.2,
      "text": "已超过70%"
    },
    {
      "start": 463.2,
      "end": 465.0,
      "text": "激光雷达在物理AI系统中"
    },
    {
      "start": 465.0,
      "end": 466.6,
      "text": "扮演着双重角色"
    },
    {
      "start": 466.6,
      "end": 468.6,
      "text": "它继服务于自动价势乘用车"
    },
    {
      "start": 468.6,
      "end": 470.6,
      "text": "这一最大规模的应用场景"
    },
    {
      "start": 470.6,
      "end": 474.8,
      "text": "又为巨身智能设备提供高精度空间感知能力"
    },
    {
      "start": 474.8,
      "end": 478.2,
      "text": "国内走激光雷达方向的代表企业有核赛科技"
    },
    {
      "start": 478.2,
      "end": 480.1,
      "text": "以43%的施战率"
    },
    {
      "start": 480.1,
      "end": 484.4,
      "text": "位居全球ADAS主激光雷达出货量第一"
    },
    {
      "start": 484.4,
      "end": 488.9,
      "text": "立决传感器是让物理AI系统摸得到空的住的关键"
    },
    {
      "start": 488.9,
      "end": 492.0,
      "text": "它决定了机器人能否完成抓取鸡蛋"
    },
    {
      "start": 492.0,
      "end": 495.6,
      "text": "精密装配 人机交互等惊喜操作"
    },
    {
      "start": 495.6,
      "end": 499.6,
      "text": "昆惟科技是中国高端利控传感器突围的典范"
    },
    {
      "start": 499.6,
      "end": 504.6,
      "text": "致力传感近期发布了搭配AI端测芯片的6位利传感器"
    },
    {
      "start": 504.6,
      "end": 508.1,
      "text": "将利控响应速度压缩至10毫秒以内"
    },
    {
      "start": 508.1,
      "end": 512.2,
      "text": "3 执行层 检速器 电机与零巧手"
    },
    {
      "start": 512.2,
      "end": 516.6,
      "text": "执行器是决定机器人性能的核心硬件环节"
    },
    {
      "start": 516.6,
      "end": 521.1,
      "text": "斜波检速器领域 绿的斜波全球施战率約25%"
    },
    {
      "start": 521.1,
      "end": 526.6,
      "text": "是特斯拉Optimus 语述等头部机器人企业的核心供应商之一"
    },
    {
      "start": 526.6,
      "end": 531.3,
      "text": "零巧手方面 赵威机电的B20零巧手拥有20个自由度"
    },
    {
      "start": 531.3,
      "end": 536.3,
      "text": "整手紧600G 以与华为等头部客户达成定单一项"
    },
    {
      "start": 536.3,
      "end": 539.8,
      "text": "空心杯电机方面 明治电器打破海外垄断"
    },
    {
      "start": 539.8,
      "end": 543.8,
      "text": "使机器人零巧手关节电机的第一体对供应商"
    },
    {
      "start": 543.8,
      "end": 546.6,
      "text": "五周新春布局的行星滚注思缸"
    },
    {
      "start": 546.6,
      "end": 550.2,
      "text": "是线性执行器的心脏 技术必类极高"
    },
    {
      "start": 550.3,
      "end": 552.6,
      "text": "语述科技不仅是整机厂商"
    },
    {
      "start": 552.6,
      "end": 557.1,
      "text": "也在资源高纽剧 似乎电机等领域深度布局执行层"
    },
    {
      "start": 557.1,
      "end": 559.4,
      "text": "三 整机与机成商"
    },
    {
      "start": 559.4,
      "end": 561.9,
      "text": "从人型机器人到自动架时"
    },
    {
      "start": 561.9,
      "end": 565.0,
      "text": "Figure AI 智园机器人 语述机器人"
    },
    {
      "start": 565.0,
      "end": 568.1,
      "text": "博士顿动力 优弊选等整机厂商"
    },
    {
      "start": 568.1,
      "end": 570.2,
      "text": "处于产业链的最前端"
    },
    {
      "start": 570.2,
      "end": 573.9,
      "text": "直接面向市场提供物理AI的载体产品"
    },
    {
      "start": 573.9,
      "end": 577.4,
      "text": "在自动架时领域 微某 特斯拉 小棚汽车等"
    },
    {
      "start": 577.4,
      "end": 580.6,
      "text": "是物理AI系统的核心应用方"
    },
    {
      "start": 580.6,
      "end": 583.3,
      "text": "随着L3极自动架时法规逐步落地"
    },
    {
      "start": 583.3,
      "end": 585.3,
      "text": "与L4极路侧的推进"
    },
    {
      "start": 585.3,
      "end": 587.5,
      "text": "物理AI驱动下的智能架势"
    },
    {
      "start": 587.5,
      "end": 590.6,
      "text": "正加速进入规模化部署阶段"
    },
    {
      "start": 590.6,
      "end": 592.1,
      "text": "分析到这里你也明白了"
    },
    {
      "start": 592.1,
      "end": 596.2,
      "text": "AI的终局从来不在屏幕里生成文字和图像"
    },
    {
      "start": 596.2,
      "end": 599.1,
      "text": "而是在屏幕外改造物理事件"
    },
    {
      "start": 599.1,
      "end": 602.3,
      "text": "它的终局是成为像电网 互联网"
    },
    {
      "start": 602.3,
      "end": 604.4,
      "text": "高速公路一样的基础设施"
    },
    {
      "start": 604.4,
      "end": 606.6,
      "text": "而且是最高违度的基础设施"
    },
    {
      "start": 606.6,
      "end": 608.6,
      "text": "一种能够自主运行"
    },
    {
      "start": 608.6,
      "end": 612.3,
      "text": "维护病升级其他基础设施的原设施"
    },
    {
      "start": 612.3,
      "end": 616.0,
      "text": "物理AI就是这个原设施的核心引擎"
    },
    {
      "start": 616.0,
      "end": 619.3,
      "text": "黄人宣在2025年的因为达GPU技术大会上"
    },
    {
      "start": 619.3,
      "end": 620.2,
      "text": "它就断言"
    },
    {
      "start": 620.2,
      "end": 624.9,
      "text": "生成是AI 以成为过去 未来属于物理AI"
    },
    {
      "start": 624.9,
      "end": 627.5,
      "text": "所以臣也高呼普通AI落幕"
    },
    {
      "start": 627.5,
      "end": 630.9,
      "text": "物理AI才是未来三年唯一主线"
    },
    {
      "start": 630.9,
      "end": 633.8,
      "text": "AI的上半场我们教会了机器思考"
    },
    {
      "start": 633.8,
      "end": 634.5,
      "text": "下半场"
    },
    {
      "start": 634.5,
      "end": 637.5,
      "text": "我们必须面对一个由机器参与运作"
    },
    {
      "start": 637.5,
      "end": 639.9,
      "text": "和决策的物理事件"
    },
    {
      "start": 639.9,
      "end": 640.9,
      "text": "在这个事件里"
    },
    {
      "start": 640.9,
      "end": 643.0,
      "text": "代码将拥有真实的重量"
    },
    {
      "start": 643.0,
      "end": 645.5,
      "text": "算法将承担切实的责任"
    },
    {
      "start": 645.5,
      "end": 647.7,
      "text": "而我们每个人都将是这座"
    },
    {
      "start": 647.7,
      "end": 649.7,
      "text": "展新基础设施的居住者"
    },
    {
      "start": 649.7,
      "end": 651.1,
      "text": "与它的构建者"
    }
  ]
