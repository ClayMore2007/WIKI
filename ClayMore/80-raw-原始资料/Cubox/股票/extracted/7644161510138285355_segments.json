    {
      "start": 129.92,
      "end": 131.12,
      "text": "美國亞利桑那間中"
    },
    {
      "start": 131.12,
      "end": 131.64,
      "text": "實現了"
    },
    {
      "start": 131.64,
      "end": 132.72,
      "text": "到了2027年"
    },
    {
      "start": 132.72,
      "end": 133.6,
      "text": "玻璃機板"
    },
    {
      "start": 133.6,
      "end": 135.6,
