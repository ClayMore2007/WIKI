    {
      "start": 162.56,
      "end": 163.92,
      "text": "按照公司的規劃"
    },
    {
      "start": 163.92,
      "end": 166.16,
      "text": "2028年要正式樹立玻璃機"
    },
    {
      "start": 166.16,
      "end": 167.28,
      "text": "半導體品牌"
    },
    {
      "start": 167.32,
      "end": 168.96,
      "text": "2029年就要實現封裝"
    },
    {
      "start": 168.96,
      "end": 172.0,
      "text": "尺寸120成120毫米以上的規模化量產"
    },
    {
      "start": 172.0,
      "end": 174.16,
      "text": "再加上他們跟康寧深度合作"
    },
    {
      "start": 174.16,
      "end": 175.48,
      "text": "原偏供應很穩"
    },
    {
      "start": 175.48,
      "end": 177.0,
      "text": "絕對是國內的核心平台"
    },
    {
      "start": 177.0,
      "end": 178.28,
      "text": "還有握格光電"
    },
    {
      "start": 178.28,
      "end": 180.08,
      "text": "他們是全球少數掌握"
    },
    {
      "start": 180.08,
      "end": 182.32,
      "text": "玻璃通孔全製成技術的企業"
    },
    {
      "start": 182.32,
      "end": 183.76,
      "text": "子公司通隔微頭鍵了"
    },
    {
      "start": 183.76,
      "end": 186.16,
      "text": "年產100萬平米的封裝載板項目"
