    {
      "start": 146.52,
      "end": 148.16,
      "text": "雖然因特爾因為達"
    },
    {
      "start": 148.16,
      "end": 150.56,
      "text": "和三星電機這些海外巨頭起步早"
    },
    {
      "start": 150.56,
      "end": 152.4,
      "text": "但國內企業追得非常兇"
    },
    {
      "start": 152.4,
      "end": 154.64,
      "text": "將京東方A作為國內首家"
