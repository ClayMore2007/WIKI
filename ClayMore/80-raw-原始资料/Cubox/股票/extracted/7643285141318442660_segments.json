{
  "language": "zh",
  "duration": 108.112125,
  "segments": [
    {
      "start": 0.0,
      "end": 3.08,
      "text": "下一批NB黑马藏在这四大塞导"
    },
    {
      "start": 3.08,
      "end": 6.4,
      "text": "分析不易,大家关注收藏,第一个DSP电芯片"
    },
    {
      "start": 6.4,
      "end": 9.16,
      "text": "DSP电芯片是光模块的大脑"
    },
    {
      "start": 9.16,
      "end": 12.24,
      "text": "所有光信号的收发、翻译、修复"
    },
    {
      "start": 12.24,
      "end": 14.48,
      "text": "纠错都靠DSP一个芯片完成"
    },
    {
      "start": 14.48,
      "end": 17.48,
      "text": "目前DSP电芯片被美国伯通"
    },
    {
      "start": 17.48,
      "end": 19.72,
      "text": "麻围两家公司百分之百共断"
    },
    {
      "start": 19.72,
      "end": 21.44,
      "text": "一颗国产都没有"
    },
    {
      "start": 21.44,
      "end": 24.92,
      "text": "DSP电芯片是光模块真正卡伯子的核心"
    },
    {
      "start": 24.92,
      "end": 27.0,
      "text": "后续大概率是一个黑马塞导"
    },
    {
      "start": 27.0,
      "end": 29.56,
      "text": "第二个玻璃基本扣心先进风光"
    },
    {
      "start": 29.72,
      "end": 32.72,
      "text": "之前开我DS的风庄的规理做太贵"
    },
    {
      "start": 32.72,
      "end": 34.44,
      "text": "产能不够,还散热差"
    },
    {
      "start": 34.44,
      "end": 36.44,
      "text": "现在全行业即将换成玻璃机板"
    },
    {
      "start": 36.44,
      "end": 39.12,
      "text": "现在这个技术的渗透率还不到1%"
    },
    {
      "start": 39.12,
      "end": 41.84,
      "text": "台级电今年就要开第一条量产线"
    },
    {
      "start": 41.84,
      "end": 44.08,
      "text": "英伟达直接砸了32亿美元"
    },
    {
      "start": 44.08,
      "end": 46.88,
      "text": "把未来10年的玻璃机板产能全部锁定"
    },
    {
      "start": 46.88,
      "end": 50.08,
      "text": "从1%长到20%就是20倍的市场空间"
    },
    {
      "start": 50.08,
      "end": 52.6,
      "text": "第三个,微光CPU的风测设备"
    },
    {
      "start": 52.6,
      "end": 53.56,
      "text": "很多人不知道"
    },
    {
      "start": 53.56,
      "end": 55.64,
      "text": "做光模块,做规光芯片"
    },
    {
      "start": 55.64,
      "end": 57.64,
      "text": "最难的不是材料"
    },
    {
      "start": 57.92,
      "end": 60.2,
      "text": "不是设计,设计是风庄设备"
    },
    {
      "start": 60.2,
      "end": 62.64,
      "text": "全世界能做高端规光风测设备的"
    },
    {
      "start": 62.64,
      "end": 63.48,
      "text": "就两家"
    },
    {
      "start": 63.48,
      "end": 64.96,
      "text": "德国分口态克"
    },
    {
      "start": 64.96,
      "end": 67.04,
      "text": "瑞典麦康宁,极度垄断"
    },
    {
      "start": 67.04,
      "end": 69.72,
      "text": "今年全球规光风庄设备的需求量"
    },
    {
      "start": 69.72,
      "end": 71.8,
      "text": "直接暴涨了320%"
    },
    {
      "start": 71.8,
      "end": 73.96,
      "text": "需求爆炸,共济稀缺"
    },
    {
      "start": 73.96,
      "end": 76.08,
      "text": "垄断闭嘞,国产空白"
    },
    {
      "start": 76.08,
      "end": 79.12,
      "text": "这种塞导是最容易走出10倍黑马的地方"
    },
    {
      "start": 79.12,
      "end": 81.8,
      "text": "第四个,HBM半导体材料"
    },
    {
      "start": 81.8,
      "end": 84.04,
      "text": "现在AR最大的平静不是GPU"
    },
    {
      "start": 84.04,
      "end": 85.4,
      "text": "是HPM的类型"
    },
    {
      "start": 85.4,
      "end": 86.76,
      "text": "但很多人不知道"
    },
    {
      "start": 86.76,
      "end": 89.04,
      "text": "HBM最赚钱的不是芯片本身"
    },
    {
      "start": 89.04,
      "end": 91.4,
      "text": "是上游的风庄材料"
    },
    {
      "start": 91.4,
      "end": 94.8,
      "text": "一颗HBM31的芯片材料成本站的40%"
    },
    {
      "start": 94.8,
      "end": 97.0,
      "text": "现在这些高端材料基本全靠进口"
    },
    {
      "start": 97.0,
      "end": 99.04,
      "text": "国产T代率不到5%"
    },
    {
      "start": 99.04,
      "end": 102.04,
      "text": "未来3年,国产T代率要充到50%"
    },
    {
      "start": 102.04,
      "end": 103.76,
      "text": "这就是10倍的总长空间"
    },
    {
      "start": 103.76,
      "end": 105.0,
      "text": "刚需中的刚需"
    }
  ]
}