  "segments": [
    {
      "start": 0.02,
      "end": 3.18,
      "text": "其實量價口覺最經典的就那麼氣句話"
    },
    {
      "start": 3.18,
      "end": 7.46,
      "text": "第一位無量要等 等錯也要等 高位無量要拿"
    },
    {
      "start": 7.46,
      "end": 10.94,
      "text": "拿錯了也要拿 第一位放量要跟"
    },
    {
      "start": 10.94,
      "end": 13.94,
      "text": "跟錯也要跟 高位放量要跑"
    },
    {
      "start": 13.94,
      "end": 17.54,
      "text": "跑錯了也要跑 量增加深要買入"
    },
    {
      "start": 17.54,
      "end": 20.02,
      "text": "量增加結 要賣出"
    },
    {
      "start": 20.02,
      "end": 24.66,
      "text": "量增加平要轉音 量平價深要加倉"
    },
    {
      "start": 24.66,
      "end": 29.02,
      "text": "最後量平價跌出局 量減價深持有"
    },
    {
      "start": 30.02,
      "end": 32.02,
      "text": "等音"
    }
  ]
}