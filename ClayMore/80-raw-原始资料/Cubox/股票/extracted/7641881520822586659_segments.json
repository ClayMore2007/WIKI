{
  "language": "zh",
  "duration": 390.977625,
  "segments": [
    {
      "start": 0.0,
      "end": 2.28,
      "text": "哪幾家創新要期可能迎來歷史性反轉"
    },
    {
      "start": 2.28,
      "end": 2.96,
      "text": "馬上6月"
    },
    {
      "start": 2.96,
      "end": 4.8,
      "text": "AACO年會就要開幕了"
    },
    {
      "start": 4.8,
      "end": 6.96,
      "text": "這場全球創新要的期末考試"
    },
    {
      "start": 6.96,
      "end": 9.96,
      "text": "真的會成為檢驗反轉程色的終極實驚時"
    },
    {
      "start": 9.96,
      "end": 10.92,
      "text": "今天這個視頻"
    },
    {
      "start": 10.92,
      "end": 11.96,
      "text": "我們來梳理一下"
    },
    {
      "start": 11.96,
      "end": 12.84,
      "text": "我們要明白"
    },
    {
      "start": 12.84,
      "end": 14.92,
      "text": "在退朝期看那些扭虧的數字"
    },
    {
      "start": 14.92,
      "end": 17.12,
      "text": "其實裡面可能會有採集的成分"
    },
    {
      "start": 17.12,
      "end": 18.36,
      "text": "但在長朝的時候"
    },
    {
      "start": 18.36,
      "end": 20.48,
      "text": "只有自主造學才是真正的反轉"
    },
    {
      "start": 20.48,
      "end": 21.64,
      "text": "2025年報"
    },
    {
      "start": 21.64,
      "end": 23.88,
      "text": "以及2026年一季度採報一出來"
    },
    {
      "start": 23.88,
      "end": 24.68,
      "text": "你會發現"
    },
    {
      "start": 24.68,
      "end": 27.4,
      "text": "創新要期的盈利程色已經徹底分化了"
    },
    {
      "start": 27.4,
      "end": 29.84,
      "text": "這裡面新大生物交出了中國 Biotech"
    },
    {
      "start": 29.84,
      "end": 32.28,
      "text": "史上最有理成悲意義的成績單"
    },
    {
      "start": 32.28,
      "end": 34.4,
      "text": "算是徹底擺脫了對跨境授權"
    },
    {
      "start": 34.4,
      "end": 35.84,
      "text": "BD一次性收入的依賴"
    },
    {
      "start": 35.84,
      "end": 37.0,
      "text": "在2025年"
    },
    {
      "start": 37.0,
      "end": 39.72,
      "text": "他們的總營收是130.4億元"
    },
    {
      "start": 39.72,
      "end": 41.12,
      "text": "這裡面產品銷售收入"
    },
    {
      "start": 41.12,
      "end": 43.12,
      "text": "就高達119.0億元"
    },
    {
      "start": 43.12,
      "end": 44.88,
      "text": "占比超過91%"
    },
    {
      "start": 44.88,
      "end": 45.88,
      "text": "這等於只他們的"
    },
    {
      "start": 45.88,
      "end": 47.92,
      "text": "iFARS經歷量8.14億元"
    },
    {
      "start": 47.92,
      "end": 50.6,
      "text": "還有NON iFARS經歷量17.23億元"
    },
    {
      "start": 50.6,
      "end": 52.92,
      "text": "完全是由國內18款獲批產品的"
    },
    {
      "start": 52.92,
      "end": 54.88,
      "text": "銷售基本盤印深深打出來的"
    },
    {
      "start": 54.88,
      "end": 57.08,
      "text": "BD授權費只佔了幾小時的比例"
    },
    {
      "start": 57.08,
      "end": 58.56,
      "text": "而且同比還在下滑"
    },
    {
      "start": 58.56,
      "end": 59.92,
      "text": "隨著規模效應顯現"
    },
    {
      "start": 59.92,
      "end": 62.72,
      "text": "他們的毛利率飆升到了87.2%"
    },
    {
      "start": 62.72,
      "end": 65.68,
      "text": "銷售集管理費率降到了48.0%"
    },
    {
      "start": 65.68,
      "end": 67.64,
      "text": "經營性現金流持續維證"
    },
    {
      "start": 67.64,
      "end": 70.12,
      "text": "現金儲備高達243億元"
    },
    {
      "start": 70.12,
      "end": 72.76,
      "text": "確實確立了純內生造雪的模範地位"
    },
    {
      "start": 72.76,
      "end": 76.16,
      "text": "融倉生物這邊則呈現出了另一種反轉的路徑"
    },
    {
      "start": 76.16,
      "end": 77.72,
      "text": "在2026年1季度"
    },
    {
      "start": 77.72,
      "end": 80.56,
      "text": "他們的賬面規模經歷是3.28億元"
    },
    {
      "start": 80.56,
      "end": 82.92,
      "text": "但這主要源於RCSBA雙抗授權"
    },
    {
      "start": 82.92,
      "end": 84.8,
      "text": "愛部為的56億美元合作力"
    },
    {
      "start": 84.8,
      "end": 86.44,
      "text": "6.5億美元首付款"
    },
    {
      "start": 86.48,
      "end": 87.44,
      "text": "進行了部分確認"
    },
    {
      "start": 87.44,
      "end": 88.8,
      "text": "如果提出這一筆外款"
    },
    {
      "start": 88.8,
      "end": 91.0,
      "text": "他們的扣飛經歷量其實仍就是威虧的"
    },
    {
      "start": 91.0,
      "end": 92.88,
      "text": "不過這裡面最近的一個信號"
    },
    {
      "start": 92.88,
      "end": 94.56,
      "text": "是他們的經營活動現金流徑"
    },
    {
      "start": 94.56,
      "end": 96.28,
      "text": "而歷史上首次轉證了"
    },
    {
      "start": 96.28,
      "end": 98.44,
      "text": "達到了1131.80萬元"
    },
    {
      "start": 98.44,
      "end": 101.24,
      "text": "這說明即便不靠融資和BD書寫"
    },
    {
      "start": 101.24,
      "end": 104.4,
      "text": "他們的產品銷售也已經能覆蓋日常運營了"
    },
    {
      "start": 104.4,
      "end": 106.6,
      "text": "底層的經營軌點其實已經出來了"
    },
    {
      "start": 106.6,
      "end": 109.04,
      "text": "諾成建華這次是文穩跨過的營利軌點"
    },
    {
      "start": 109.04,
      "end": 112.28,
      "text": "他們的2025年營收大增15.27%"
    },
    {
      "start": 112.28,
      "end": 114.76,
      "text": "規模經歷做到了6.4億元"
    },
    {
      "start": 114.76,
      "end": 117.2,
      "text": "並且在2026年3月正式脫貿"
    },
    {
      "start": 117.2,
      "end": 119.56,
      "text": "取消了股票簡稱特別標實優"
    },
    {
      "start": 119.56,
      "end": 121.76,
      "text": "實現了可持續的商業化反轉"
    },
    {
      "start": 121.76,
      "end": 122.6,
      "text": "相比之下"
    },
    {
      "start": 122.6,
      "end": 125.56,
      "text": "康芳生物現在還處於戰略性虧損階段"
    },
    {
      "start": 125.56,
      "end": 128.6,
      "text": "雖然他們的商業銷售收入達到了30.33億元"
    },
    {
      "start": 128.6,
      "end": 130.08,
      "text": "大增了51%"
    },
    {
      "start": 130.08,
      "end": 132.8,
      "text": "但因為研發開支加碼到了15.75億"
    },
    {
      "start": 132.8,
      "end": 134.32,
      "text": "所以年內的虧損有所擴大"
    },
    {
      "start": 134.32,
      "end": 137.08,
      "text": "其實他們手握88.2億元的現金儲備"
    },
    {
      "start": 137.08,
      "end": 139.32,
      "text": "正處於手握重兵的投入期"
    },
    {
      "start": 139.32,
      "end": 141.44,
      "text": "核心看點主要還是在海外的進展"
    },
    {
      "start": 141.44,
      "end": 142.16,
      "text": "說白了"
    },
    {
      "start": 142.16,
      "end": 143.56,
      "text": "利潤反轉的背後"
    },
    {
      "start": 143.6,
      "end": 145.48,
      "text": "本質上是商業化能力的致變"
    },
    {
      "start": 145.48,
      "end": 148.12,
      "text": "在2025年至2026年這段時間裡"
    },
    {
      "start": 148.12,
      "end": 151.12,
      "text": "整個行業已經徹底告別了過去的人海戰術"
    },
    {
      "start": 151.12,
      "end": 152.8,
      "text": "開始賣入經益人銷時代"
    },
    {
      "start": 152.8,
      "end": 154.0,
      "text": "你看新達生物"
    },
    {
      "start": 154.0,
      "end": 155.8,
      "text": "他們近3000人的商業化團隊"
    },
    {
      "start": 155.8,
      "end": 158.12,
      "text": "創造了1191的產品銷售額"
    },
    {
      "start": 158.12,
      "end": 160.72,
      "text": "人均單產直接越升到了將近400萬元"
    },
    {
      "start": 160.72,
      "end": 161.04,
      "text": "每年"
    },
    {
      "start": 161.04,
      "end": 164.32,
      "text": "這個數據遠遠超過了BIO T1CH覆蓋體系成本的"
    },
    {
      "start": 164.32,
      "end": 165.04,
      "text": "深思線"
    },
    {
      "start": 165.04,
      "end": 166.32,
      "text": "也就是通常說的"
    },
    {
      "start": 166.32,
      "end": 168.0,
      "text": "150到200萬元美人"
    },
    {
      "start": 168.0,
      "end": 170.32,
      "text": "這比賬不僅應證了管理效率的提升"
    },
    {
      "start": 170.32,
      "end": 172.48,
      "text": "也解釋了為什麼他們的利潤增速"
    },
    {
      "start": 172.48,
      "end": 174.28,
      "text": "能遠遠超過營收的增速"
    },
    {
      "start": 174.28,
      "end": 174.96,
      "text": "同時"
    },
    {
      "start": 174.96,
      "end": 176.24,
      "text": "依保放量的邏輯"
    },
    {
      "start": 176.24,
      "end": 178.32,
      "text": "也從以前的已加換量"
    },
    {
      "start": 178.32,
      "end": 180.48,
      "text": "變成了現在的已量增收"
    },
    {
      "start": 180.48,
      "end": 181.96,
      "text": "在新一輪的依保談判裡"
    },
    {
      "start": 181.96,
      "end": 183.6,
      "text": "獨家創新要的平均降幅"
    },
    {
      "start": 183.6,
      "end": 186.52,
      "text": "顯著收窄到了40%到45%"
    },
    {
      "start": 186.52,
      "end": 189.16,
      "text": "總算終結了早年動折膝蓋展的怪權"
    },
    {
      "start": 189.16,
      "end": 190.8,
      "text": "將新達生物的馬士度態"
    },
    {
      "start": 190.8,
      "end": 192.36,
      "text": "還有榮昌生物的太塌"
    },
    {
      "start": 192.36,
      "end": 195.4,
      "text": "西普和維帝西陀擔抗這些核心大擔憑"
    },
    {
      "start": 195.4,
      "end": 197.36,
      "text": "在新市印證納入依保之後"
    },
    {
      "start": 197.36,
      "end": 199.28,
      "text": "銷量的爆發協率非常高"
    },
    {
      "start": 199.28,
      "end": 201.52,
      "text": "直接推動了銷售菲律的下降"
    },
    {
      "start": 201.56,
      "end": 203.24,
      "text": "利潤修復得挺明顯的"
    },
    {
      "start": 203.24,
      "end": 204.48,
      "text": "其實即將到來的"
    },
    {
      "start": 204.48,
      "end": 205.32,
      "text": "AACO會議"
    },
    {
      "start": 205.32,
      "end": 206.96,
      "text": "就是現在最大的催化劑"
    },
    {
      "start": 206.96,
      "end": 208.68,
      "text": "兩大核心數據的預期差"
    },
    {
      "start": 208.68,
      "end": 209.64,
      "text": "會直接決定"
    },
    {
      "start": 209.64,
      "end": 210.92,
      "text": "估值重估的空間"
    },
    {
      "start": 210.92,
      "end": 212.32,
      "text": "抗方生物的依我吸"
    },
    {
      "start": 212.32,
      "end": 213.96,
      "text": "單抗AK112"
    },
    {
      "start": 213.96,
      "end": 214.92,
      "text": "現在正迎來"
    },
    {
      "start": 214.92,
      "end": 216.64,
      "text": "衝擊全球新要王的OS"
    },
    {
      "start": 216.64,
      "end": 218.04,
      "text": "總生存期終極戰"
    },
    {
      "start": 218.04,
      "end": 219.08,
      "text": "之前他們頭對頭"
    },
    {
      "start": 219.08,
      "end": 219.68,
      "text": "擊敗KL"
    },
    {
      "start": 219.68,
      "end": 221.2,
      "text": "趴玻璃珠單抗這件事情"
    },
    {
      "start": 221.2,
      "end": 222.4,
      "text": "已經轟動了全球"
    },
    {
      "start": 222.4,
      "end": 223.36,
      "text": "而這次主席大會"
    },
    {
      "start": 223.36,
      "end": 225.0,
      "text": "將要公布一線零狀"
    },
    {
      "start": 225.0,
      "end": 227.08,
      "text": "非小細胞肺癌的最終OS數據"
    },
    {
      "start": 227.08,
      "end": 228.32,
      "text": "現在市場博弈的焦點"
    },
    {
      "start": 228.32,
      "end": 229.88,
      "text": "主要在風險比HR上面"
    },
    {
      "start": 229.92,
      "end": 231.76,
      "text": "如果HR只小於0.70"
    },
    {
      "start": 231.76,
      "end": 234.56,
      "text": "也就是降低了30%以上的死亡風險"
    },
    {
      "start": 234.56,
      "end": 236.12,
      "text": "並且具備統計學議"
    },
    {
      "start": 236.12,
      "end": 237.36,
      "text": "那就直接做實了"
    },
    {
      "start": 237.36,
      "end": 239.96,
      "text": "他跌代全球精標準KL的統治地位"
    },
    {
      "start": 239.96,
      "end": 243.0,
      "text": "也等於為他在2026年11月的FDA"
    },
    {
      "start": 243.0,
      "end": 244.68,
      "text": "獲批提供了最強倍數"
    },
    {
      "start": 244.68,
      "end": 246.36,
      "text": "克倫波太的如康沙土珠"
    },
    {
      "start": 246.36,
      "end": 248.0,
      "text": "單抗SKB264"
    },
    {
      "start": 248.0,
      "end": 249.08,
      "text": "這次則會展示"
    },
    {
      "start": 249.08,
      "end": 250.6,
      "text": "犯癌這種ADC的肌肉力量"
    },
    {
      "start": 250.6,
      "end": 252.08,
      "text": "作為全球第一個獲批肺癌"
    },
    {
      "start": 252.08,
      "end": 253.76,
      "text": "適應症的TROPRA"
    },
    {
      "start": 253.76,
      "end": 255.2,
      "text": "DCEASCO"
    },
    {
      "start": 255.2,
      "end": 258.04,
      "text": "將發表他關鍵370床的全口徑數據"
    },
    {
      "start": 258.04,
      "end": 259.44,
      "text": "市場現在重點關注"
    },
    {
      "start": 259.44,
      "end": 261.28,
      "text": "他的中位無盡展生存期"
    },
    {
      "start": 261.28,
      "end": 263.48,
      "text": "PFS能不能顯著超越進品"
    },
    {
      "start": 263.48,
      "end": 266.0,
      "text": "並且是不是展現出了更好的治療窗口"
    },
    {
      "start": 266.0,
      "end": 269.08,
      "text": "尤其是那種極低的堅製性肺炎發生率"
    },
    {
      "start": 269.08,
      "end": 270.76,
      "text": "如果這個數據非常優異"
    },
    {
      "start": 270.76,
      "end": 272.6,
      "text": "就會催化合作夥伴莫殺東"
    },
    {
      "start": 272.6,
      "end": 275.56,
      "text": "全面啟動他們那個龐大的全球370床計畫"
    },
    {
      "start": 275.56,
      "end": 277.32,
      "text": "把現在和以前對比一下"
    },
    {
      "start": 277.32,
      "end": 279.52,
      "text": "你會發現跨境授權BD的本質"
    },
    {
      "start": 279.52,
      "end": 281.52,
      "text": "已經發生了天翻地負的變化"
    },
    {
      "start": 281.52,
      "end": 283.52,
      "text": "這其實就是產業反轉的底氣所在"
    },
    {
      "start": 283.52,
      "end": 286.84,
      "text": "我忘2023年至2024年那段冰點期"
    },
    {
      "start": 286.84,
      "end": 288.88,
      "text": "企業大多是被迫斷壁求生"
    },
    {
      "start": 288.88,
      "end": 290.32,
      "text": "就像之前的更起生物"
    },
    {
      "start": 290.32,
      "end": 291.84,
      "text": "因為現今流快哭解了"
    },
    {
      "start": 291.84,
      "end": 294.0,
      "text": "最後被阿斯利康折價全自收購"
    },
    {
      "start": 294.0,
      "end": 295.16,
      "text": "還有天進生物"
    },
    {
      "start": 295.16,
      "end": 296.92,
      "text": "也是被迫剝離資產來求生"
    },
    {
      "start": 296.92,
      "end": 298.6,
      "text": "那會兒的BD說白了就是"
    },
    {
      "start": 298.6,
      "end": 299.8,
      "text": "手裡沒涼不慢"
    },
    {
      "start": 299.8,
      "end": 300.64,
      "text": "就要破產"
    },
    {
      "start": 300.64,
      "end": 302.0,
      "text": "首付比例幾低"
    },
    {
      "start": 302.0,
      "end": 303.8,
      "text": "而且還要面臨退貨的風險"
    },
    {
      "start": 303.8,
      "end": 306.4,
      "text": "但現在到了2025年至2026年"
    },
    {
      "start": 306.4,
      "end": 308.32,
      "text": "BD已經演變成了強強聯合"
    },
    {
      "start": 308.32,
      "end": 311.56,
      "text": "拿榮昌生物和艾伯為56億美元的合作為例"
    },
    {
      "start": 311.56,
      "end": 313.8,
      "text": "首付款就高達6.5億美元"
    },
    {
      "start": 313.8,
      "end": 315.92,
      "text": "首付比達到了11.6%"
    },
    {
      "start": 315.92,
      "end": 318.44,
      "text": "而且企業還保留了大中華區的權益"
    },
    {
      "start": 318.44,
      "end": 320.64,
      "text": "這種模式本質上就是借養人的錢"
    },
    {
      "start": 320.64,
      "end": 321.8,
      "text": "養自己的管線"
    },
    {
      "start": 321.8,
      "end": 324.0,
      "text": "企業手裡掌握了戰略主動權"
    },
    {
      "start": 324.0,
      "end": 325.92,
      "text": "還不是像以前那樣被動見賣"
    },
    {
      "start": 325.92,
      "end": 327.8,
      "text": "放心要起現在能在國內愛的動"
    },
    {
      "start": 327.8,
      "end": 328.96,
      "text": "而且賺得到錢"
    },
    {
      "start": 328.96,
      "end": 331.08,
      "text": "其實離不開支付環境的底層重購"
    },
    {
      "start": 331.08,
      "end": 332.0,
      "text": "在意保端"
    },
    {
      "start": 332.0,
      "end": 333.84,
      "text": "簡易虛約規則落地之後"
    },
    {
      "start": 333.84,
      "end": 336.32,
      "text": "百計神州和性達生物等核心產品"
    },
    {
      "start": 336.32,
      "end": 338.76,
      "text": "在虛約的時候價格幾乎沒有什麼波動"
    },
    {
      "start": 338.76,
      "end": 340.44,
      "text": "這文文保證了利潤空間"
    },
    {
      "start": 340.44,
      "end": 341.48,
      "text": "而在商保端"
    },
    {
      "start": 341.48,
      "end": 343.88,
      "text": "會民保以及百萬醫療顯的升級版"
    },
    {
      "start": 343.88,
      "end": 347.64,
      "text": "已經正式成為了雙抗和ADC等高值要務的第二支付方"
    },
    {
      "start": 347.64,
      "end": 349.8,
      "text": "像康芳生物的卡東尼利丹康"
    },
    {
      "start": 349.8,
      "end": 352.6,
      "text": "通過被納入了超過80個城市的會民保"
    },
    {
      "start": 352.6,
      "end": 353.6,
      "text": "商保渠道"
    },
    {
      "start": 353.6,
      "end": 356.32,
      "text": "直接貢獻了將近30%的銷售額"
    },
    {
      "start": 356.32,
      "end": 358.24,
      "text": "商保特要目錄的支付機制"
    },
    {
      "start": 358.24,
      "end": 360.96,
      "text": "也成功繞開了醫院藥占筆的考核"
    },
    {
      "start": 360.96,
      "end": 363.2,
      "text": "引爆了願外DTP藥房的銷售"
    },
    {
      "start": 363.2,
      "end": 365.36,
      "text": "這些其實都已經直接反映在企業"
    },
    {
      "start": 365.36,
      "end": 367.24,
      "text": "最近這兩個季度的財報中了"
    },
    {
      "start": 367.24,
      "end": 370.56,
      "text": "從以前賣資產血盔到現在的自主營利"
    },
    {
      "start": 370.56,
      "end": 371.8,
      "text": "中國創新藥企"
    },
    {
      "start": 371.8,
      "end": 374.48,
      "text": "確實正在經歷一場脫胎換股的重速"
    },
    {
      "start": 374.48,
      "end": 375.28,
      "text": "隨著6月份"
    },
    {
      "start": 375.28,
      "end": 377.28,
      "text": "ACO會議的終身即將敲響"
    },
    {
      "start": 377.4,
      "end": 379.24,
      "text": "屬於中國創新藥的黃金時代"
    },
    {
      "start": 379.24,
      "end": 380.6,
      "text": "感覺才剛剛開始"
    },
    {
      "start": 380.6,
      "end": 383.44,
      "text": "咱們今天把這些正在發生的細節理了一遍"
    },
    {
      "start": 383.44,
      "end": 386.12,
      "text": "後面多盯著這幾個關鍵底層環節的進展"
    },
    {
      "start": 386.12,
      "end": 386.96,
      "text": "有新變化了"
    },
    {
      "start": 386.96,
      "end": 387.96,
      "text": "咱們再接著聊"
    }
  ]
}