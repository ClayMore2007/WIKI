{
  "language": "zh",
  "duration": 185.272,
  "segments": [
    {
      "start": 0.14,
      "end": 2.18,
      "text": "《新郁城》再报预判言论"
    },
    {
      "start": 2.18,
      "end": 4.1,
      "text": "这一次它直接宣判"
    },
    {
      "start": 4.1,
      "end": 5.38,
      "text": "普通AI伊斯"
    },
    {
      "start": 5.38,
      "end": 8.02,
      "text": "物理AI才是未来三年唯一主线"
    },
    {
      "start": 8.02,
      "end": 9.7,
      "text": "别觉得它是往红炒作"
    },
    {
      "start": 9.7,
      "end": 12.14,
      "text": "十年前它喊得比特币英美达"
    },
    {
      "start": 12.14,
      "end": 13.5,
      "text": "当年骂它丰字的人"
    },
    {
      "start": 13.5,
      "end": 15.26,
      "text": "估计现在都熬回不已"
    },
    {
      "start": 15.26,
      "end": 17.3,
      "text": "它去年说永远却存储"
    },
    {
      "start": 17.3,
      "end": 19.42,
      "text": "反复而直接走出翻备行情"
    },
    {
      "start": 19.42,
      "end": 20.94,
      "text": "今天咱不带偏见"
    },
    {
      "start": 20.94,
      "end": 22.9,
      "text": "客观聊透《新郁城》这个人"
    },
    {
      "start": 22.9,
      "end": 25.54,
      "text": "拆解物理AI到底是什么"
    },
    {
      "start": 25.54,
      "end": 28.22,
      "text": "很多人对它的印象就是高调、爱炒作"
    },
    {
      "start": 28.22,
      "end": 29.98,
      "text": "但在财经投资权"
    },
    {
      "start": 29.98,
      "end": 32.42,
      "text": "它是公认的趋势欲叛贵财"
    },
    {
      "start": 32.42,
      "end": 36.46,
      "text": "每一次发生都能采准时代技术的大风口"
    },
    {
      "start": 36.46,
      "end": 38.82,
      "text": "16年大家都在买房存资产"
    },
    {
      "start": 38.82,
      "end": 41.14,
      "text": "它全年轻人不结婚不买房"
    },
    {
      "start": 41.14,
      "end": 43.66,
      "text": "把所有的钱全投比特币英美达"
    },
    {
      "start": 43.66,
      "end": 44.18,
      "text": "结果呢"
    },
    {
      "start": 44.18,
      "end": 45.54,
      "text": "比特币报掌200多倍"
    },
    {
      "start": 45.54,
      "end": 47.14,
      "text": "英美达也翻了170倍"
    },
    {
      "start": 47.14,
      "end": 49.18,
      "text": "去年它说短期缺新片"
    },
    {
      "start": 49.18,
      "end": 51.9,
      "text": "长期缺能源永远缺存储"
    },
    {
      "start": 51.9,
      "end": 54.18,
      "text": "最后存储版块全线爆发"
    },
    {
      "start": 54.18,
      "end": 56.5,
      "text": "到目前为止也是最热门的主线"
    },
    {
      "start": 56.5,
      "end": 59.82,
      "text": "这个人最厉害的就是能提前三到五年"
    },
    {
      "start": 59.82,
      "end": 62.34,
      "text": "看到普通人看不到的产业趋势"
    },
    {
      "start": 62.34,
      "end": 63.54,
      "text": "就在了两天"
    },
    {
      "start": 63.54,
      "end": 65.54,
      "text": "它再做预判直接放话"
    },
    {
      "start": 65.54,
      "end": 67.34,
      "text": "虚拟AI已经结束"
    },
    {
      "start": 67.34,
      "end": 70.26,
      "text": "2026年就是物理AI爆发原点"
    },
    {
      "start": 70.26,
      "end": 71.78,
      "text": "它不是单纯的算法"
    },
    {
      "start": 71.78,
      "end": 75.5,
      "text": "是算法加硬件加现实物理世界的结合"
    },
    {
      "start": 75.5,
      "end": 78.9,
      "text": "是AI从线上走到线下的中级形态"
    },
    {
      "start": 78.9,
      "end": 81.22,
      "text": "这将是一个万一级别的市场"
    },
    {
      "start": 81.22,
      "end": 83.26,
      "text": "那到底什么是物理AI"
    },
    {
      "start": 83.26,
      "end": 84.14,
      "text": "简单说"
    },
    {
      "start": 84.14,
      "end": 87.06,
      "text": "我们平时玩的斗包DipSync Chat GPT"
    },
    {
      "start": 87.06,
      "end": 89.1,
      "text": "能聊天 能写文案做图片"
    },
    {
      "start": 89.1,
      "end": 90.5,
      "text": "多叫虚拟AI"
    },
    {
      "start": 90.5,
      "end": 93.62,
      "text": "只活在手机电脑里摸不着碰不到"
    },
    {
      "start": 93.62,
      "end": 96.66,
      "text": "而物理AI就是能走进现实世界"
    },
    {
      "start": 96.66,
      "end": 99.86,
      "text": "能动手干活 能操控实体的AI"
    },
    {
      "start": 99.86,
      "end": 102.86,
      "text": "说白了就是无人机 人行机器人"
    },
    {
      "start": 102.86,
      "end": 104.18,
      "text": "自动驾驶汽车"
    },
    {
      "start": 104.18,
      "end": 107.54,
      "text": "它的每一次预判从来都不是随口吹牛"
    },
    {
      "start": 107.54,
      "end": 109.02,
      "text": "每一句极端的话"
    },
    {
      "start": 109.02,
      "end": 112.82,
      "text": "背后都是对技术周期产业趋势的精准判断"
    },
    {
      "start": 112.82,
      "end": 113.5,
      "text": "更难了"
    },
    {
      "start": 113.5,
      "end": 115.7,
      "text": "物理AI的核心企业都有谁"
    },
    {
      "start": 115.7,
      "end": 116.7,
      "text": "所成科技"
    },
    {
      "start": 116.7,
      "end": 119.02,
      "text": "国产CE议访真绝对龙头"
    },
    {
      "start": 119.02,
      "end": 121.82,
      "text": "推出天功开悟物理AI平台"
    },
    {
      "start": 121.82,
      "end": 125.22,
      "text": "是人行机器人无人机的虚拟训练底座"
    },
    {
      "start": 125.22,
      "end": 126.38,
      "text": "三花智库"
    },
    {
      "start": 126.38,
      "end": 127.98,
      "text": "全球热管理龙头"
    },
    {
      "start": 127.98,
      "end": 131.62,
      "text": "主营机器人高经部关节总成与业冷散热"
    },
    {
      "start": 131.62,
      "end": 134.5,
      "text": "深度绑定克斯拉人行机器人共用量"
    },
    {
      "start": 134.5,
      "end": 135.66,
      "text": "五周新春"
    },
    {
      "start": 135.66,
      "end": 138.14,
      "text": "国内行星滚驻撕杠龙头"
    },
    {
      "start": 138.14,
      "end": 139.74,
      "text": "试炸绿接近六成"
    },
    {
      "start": 139.74,
      "end": 142.3,
      "text": "是机器人的核心传动谷歌"
    },
    {
      "start": 142.3,
      "end": 145.9,
      "text": "物理AI硬件中刚需卡脖子的核心标地"
    },
    {
      "start": 145.9,
      "end": 147.02,
      "text": "脱补集团"
    },
    {
      "start": 147.02,
      "end": 150.26,
      "text": "人行机器人仿生关节与现控地盘"
    },
    {
      "start": 150.26,
      "end": 151.86,
      "text": "技术全球领先"
    },
    {
      "start": 151.86,
      "end": 154.62,
      "text": "覆盖物理AI执行从核心环节"
    },
    {
      "start": 154.62,
      "end": 155.66,
      "text": "暴笔中光"
    },
    {
      "start": 155.66,
      "end": 158.06,
      "text": "全球三地视觉核心厂商"
    },
    {
      "start": 158.06,
      "end": 160.78,
      "text": "为物理AI提供空间感知能力"
    },
    {
      "start": 160.78,
      "end": 162.54,
      "text": "是物理AI的眼睛"
    },
    {
      "start": 162.54,
      "end": 164.38,
      "text": "感知从核心龙头"
    },
    {
      "start": 164.38,
      "end": 167.02,
      "text": "虽语臣之所以能履刺采中风口"
    },
    {
      "start": 167.02,
      "end": 168.02,
      "text": "不是运气"
    },
    {
      "start": 168.02,
      "end": 170.42,
      "text": "是它看透了技术革命的本质"
    },
    {
      "start": 170.42,
      "end": 172.58,
      "text": "从虚拟AI到物理AI"
    },
    {
      "start": 172.58,
      "end": 174.58,
      "text": "是AI行业的颠覆性电阻"
    },
    {
      "start": 174.58,
      "end": 175.18,
      "text": "关注我"
    },
    {
      "start": 175.18,
      "end": 177.9,
      "text": "我会第一时间帮你抓住市场热点机会"
    },
    {
      "start": 177.9,
      "end": 179.26,
      "text": "找到核心企业"
    },
    {
      "start": 179.26,
      "end": 180.26,
      "text": "下期不见不散"
    }
  ]
}