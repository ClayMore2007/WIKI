{
  "language": "zh",
  "duration": 35.4336875,
  "segments": [
    {
      "start": 0.0,
      "end": 2.36,
      "text": "中年发浮后怎么缩肚子最快呀"
    },
    {
      "start": 2.36,
      "end": 3.56,
      "text": "我家不要告诉他"
    },
    {
      "start": 3.56,
      "end": 6.72,
      "text": "长瘦之人刷到就留下一句扶瘦安康"
    },
    {
      "start": 6.72,
      "end": 9.0,
      "text": "中年发浮后既不用疯狂运动"
    },
    {
      "start": 9.0,
      "end": 9.96,
      "text": "也不用哀饿"
    },
    {
      "start": 9.96,
      "end": 11.64,
      "text": "肚子却能圈圈变小"
    },
    {
      "start": 11.64,
      "end": 13.16,
      "text": "你就拿一个苹果切小块"
    },
    {
      "start": 13.16,
      "end": 14.08,
      "text": "再加点山渣"
    },
    {
      "start": 14.08,
      "end": 15.92,
      "text": "橘皮和红草一起泡水喝"
    },
    {
      "start": 15.92,
      "end": 17.24,
      "text": "这个就叫刮瓜水"
    },
    {
      "start": 17.24,
      "end": 18.48,
      "text": "尤其是肚子原谷骨"
    },
    {
      "start": 18.48,
      "end": 20.0,
      "text": "实际重的刮瓜排施"
    },
    {
      "start": 20.0,
      "end": 21.2,
      "text": "每天空腹来一杯"
    },
    {
      "start": 21.2,
      "end": 22.72,
      "text": "整个人轻松又自在"
    },
    {
      "start": 22.72,
      "end": 23.8,
      "text": "如果你拐不住嘴"
    },
    {
      "start": 23.8,
      "end": 24.68,
      "text": "还卖不开嘴"
    },
    {
      "start": 24.68,
      "end": 26.16,
      "text": "经常九座还不爱运动"
    },
    {
      "start": 26.16,
      "end": 27.32,
      "text": "那你更要试试"
    },
    {
      "start": 27.32,
      "end": 29.0,
      "text": "算了 说了也白说"
    },
    {
      "start": 29.0,
      "end": 30.2,
      "text": "他都懒得去尝试"
    },
    {
      "start": 30.2,
      "end": 31.6,
      "text": "又不知道关注收藏好"
    },
    {
      "start": 31.6,
      "end": 32.52,
      "text": "我就不告诉他了"
    },
    {
      "start": 33.36,
      "end": 34.12,
      "text": "等应"
    }
  ]
}